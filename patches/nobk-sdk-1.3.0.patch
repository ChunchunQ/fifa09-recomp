+// GET https://nobkonline.com<path> (profile pictures only), at most 512 KB.
+static bool SocHttpGet(const std::string& path, std::vector<uint8_t>* out) {
+  HINTERNET ses = WinHttpOpen(L"NOBK-Online", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME,
+                              WINHTTP_NO_PROXY_BYPASS, 0);
+  if (!ses) return false;
+  WinHttpSetTimeouts(ses, 3000, 3000, 3000, 5000);
+  HINTERNET con = WinHttpConnect(ses, L"nobkonline.com", INTERNET_DEFAULT_HTTPS_PORT, 0);
+  std::wstring wp(path.begin(), path.end());
+  HINTERNET req = con ? WinHttpOpenRequest(con, L"GET", wp.c_str(), nullptr, WINHTTP_NO_REFERER,
+                                           WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE)
+                      : nullptr;
+  bool ok = false;
+  if (req && WinHttpSendRequest(req, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0) &&
+      WinHttpReceiveResponse(req, nullptr)) {
+    DWORD status = 0, sz = sizeof(status);
+    WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX,
+                        &status, &sz, WINHTTP_NO_HEADER_INDEX);
+    if (status == 200) {
+      for (;;) {
+        DWORD n = 0;
+        if (!WinHttpQueryDataAvailable(req, &n) || !n || out->size() + n > 512 * 1024) break;
+        size_t o = out->size();
+        out->resize(o + n);
+        DWORD rd = 0;
+        if (!WinHttpReadData(req, out->data() + o, n, &rd)) { out->resize(o); break; }
+        out->resize(o + rd);
+      }
+      ok = !out->empty();
+    }
+  }
+  if (req) WinHttpCloseHandle(req);
+  if (con) WinHttpCloseHandle(con);
+  WinHttpCloseHandle(ses);
+  return ok;
+}
