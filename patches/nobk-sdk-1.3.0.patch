+
+// [online] Receiving UDP game traffic (the peer-to-peer link). EA's socket
+// layer posts one overlapped WSARecvFrom per UDP socket, waits on the
+// overlapped event and collects the result with WSAGetOverlappedResult. The
+// old stub always failed, so nothing sent by the other player ever arrived.
+// Data already waiting is returned at once; otherwise a host thread waits for
+// the next datagram, fills the guest buffers/overlapped and sets the event.
+static constexpr uint32_t kStatusPending = 0x103;
+static constexpr uint32_t kWsaIoPending = 997;
+static constexpr uint32_t kWsaIoIncomplete = 996;
+
+struct PendingRecv {
+  uint64_t native = 0;
+  std::vector<std::pair<uint32_t, uint32_t>> bufs;  // guest ptr, len
+  uint32_t from_ptr = 0, fromlen_ptr = 0, overlapped_ptr = 0, bytes_ptr = 0;
+};
+
+static int NativeLastError() {
+#if REX_PLATFORM_WIN32
+  return WSAGetLastError();
+#else
+  return errno;
+#endif
+}
+static bool WouldBlock(int err) {
+#if REX_PLATFORM_WIN32
+  return err == WSAEWOULDBLOCK;
+#else
+  return err == EAGAIN || err == EWOULDBLOCK;
+#endif
+}
+
+// One native recvfrom; scatters into the guest buffers. Returns bytes, or -1
+// with *err set.
+static int RecvIntoGuest(const PendingRecv& r, int* err) {
+  size_t total = 0;
+  for (auto& b : r.bufs) total += b.second;
+  if (total == 0 || total > 0x10000) total = 0x10000;
+  std::vector<uint8_t> tmp(total);
+  sockaddr_in from = {};
+#if REX_PLATFORM_WIN32
+  int flen = static_cast<int>(sizeof(from));
+  int n = ::recvfrom(static_cast<SOCKET>(r.native), reinterpret_cast<char*>(tmp.data()),
+                     static_cast<int>(total), 0, reinterpret_cast<sockaddr*>(&from), &flen);
+#else
+  socklen_t flen = sizeof(from);
+  int n = static_cast<int>(::recvfrom(static_cast<int>(r.native), tmp.data(), total, 0,
+                                      reinterpret_cast<sockaddr*>(&from), &flen));
+#endif
+  if (n < 0) {
+    *err = NativeLastError();
+    return -1;
+  }
+  auto* mem = REX_KERNEL_MEMORY();
+  N_XSOCKADDR_IN nf;
+  nf.sin_family = AF_INET;
+  std::memcpy(&nf.sin_addr, &from.sin_addr.s_addr, 4);
+  std::memcpy(&nf.sin_port, &from.sin_port, 2);
+  size_t skip = RelayUnwrap(tmp.data(), size_t(n), from, &nf);
+  if (!skip) ApplyPeerOffsetIn(&nf);
+  const uint8_t* payload = tmp.data() + skip;
+  n -= int(skip);
+  size_t off = 0;
+  for (auto& b : r.bufs) {
+    if (off >= size_t(n)) break;
+    size_t c = std::min<size_t>(b.second, size_t(n) - off);
+    std::memcpy(mem->TranslateVirtual<uint8_t*>(b.first), payload + off, c);
+    off += c;
+  }
+  UdpStatsCount(RawPort(&nf.sin_port), false, uint32_t(n));
+  if (r.from_ptr) {
+    uint8_t* f = mem->TranslateVirtual<uint8_t*>(r.from_ptr);
+    memory::store_and_swap<uint16_t>(f + 0, 2);  // AF_INET
+    std::memcpy(f + 2, &nf.sin_port, 2);
+    std::memcpy(f + 4, &nf.sin_addr, 4);
+    std::memset(f + 8, 0, 8);
+    if (PacketLogEnabled()) {
+      char src[48], peek[64];
+      FormatSockaddr(&nf, src, sizeof(src));
+      FormatHexPeek(payload, static_cast<size_t>(n), peek, sizeof(peek));
+      REXKRNL_INFO("[net-pkt] WSARecvFrom src={}{} len={} data=[{}]", src,
+                   skip ? " (relay)" : "", n, peek);
+    }
+  }
+  if (r.fromlen_ptr) {
+    memory::store_and_swap<uint32_t>(mem->TranslateVirtual<uint8_t*>(r.fromlen_ptr), 16);
+  }
+  return n;
+}
+
+static void CompleteOverlapped(uint32_t overlapped_ptr, uint32_t status, uint32_t bytes) {
+  if (!overlapped_ptr) return;
+  auto* ov = REX_KERNEL_MEMORY()->TranslateVirtual<XWSAOVERLAPPED*>(overlapped_ptr);
+  ov->internal_high = bytes;
