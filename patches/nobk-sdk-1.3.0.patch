+// round picture (or coloured circle + initial) with a status dot
+void DrawAvatar(ImDrawList* dl, rex::ui::ImGuiDrawer* drawer, ImVec2 c, float r, const std::string& name,
+                const std::string& path, ImU32 dot, float alpha) {
+  if (auto* t = g_avatars.Get(drawer, path)) {
+    dl->AddImageRounded(reinterpret_cast<ImTextureID>(t), ImVec2(c.x - r, c.y - r), ImVec2(c.x + r, c.y + r),
+                        ImVec2(0, 0), ImVec2(1, 1), Col(255, 255, 255, alpha), r);
+  } else {
+    ImU32 bg = AvatarColour(name);
+    bg = (bg & 0x00FFFFFF) | (ImU32(255.0f * alpha) << 24);
+    dl->AddCircleFilled(c, r, bg, 40);
+    std::string ini = name.empty() ? "?" : Upper(name.substr(0, 1));
+    ImFont* f = SocialFont();
+    ImVec2 ts = f->CalcTextSizeA(r * 1.1f, FLT_MAX, 0.0f, ini.c_str());
+    dl->AddText(f, r * 1.1f, ImVec2(c.x - ts.x * 0.5f, c.y - ts.y * 0.5f), Col(255, 255, 255, alpha), ini.c_str());
+  }
+  if (dot) {
+    const float d = r * 0.3f;
+    ImVec2 p(c.x + r * 0.72f, c.y + r * 0.72f);
+    dl->AddCircleFilled(p, d + 2.5f, Col(14, 14, 16, alpha), 20);
+    dl->AddCircleFilled(p, d, (dot & 0x00FFFFFF) | (ImU32(255.0f * alpha) << 24), 20);
+  }
+}
