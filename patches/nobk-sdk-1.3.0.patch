+// a slanted bar: left edge slanted by `slant` px
+void Bar(ImDrawList* dl, ImVec2 a, ImVec2 b, float slant, ImU32 top, ImU32 bottom) {
+  const float mid = (a.y + b.y) * 0.5f;
+  ImVec2 q[4] = {ImVec2(a.x + slant, a.y), ImVec2(b.x, a.y), ImVec2(b.x, mid), ImVec2(a.x + slant * 0.5f, mid)};
+  dl->AddConvexPolyFilled(q, 4, top);
+  ImVec2 r[4] = {ImVec2(a.x + slant * 0.5f, mid), ImVec2(b.x, mid), ImVec2(b.x, b.y), ImVec2(a.x, b.y)};
+  dl->AddConvexPolyFilled(r, 4, bottom);
+}
