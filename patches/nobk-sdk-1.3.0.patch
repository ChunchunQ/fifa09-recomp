+// ---------------------------------------------------------------- friends panel
+class FriendsPanel : public XamDialog {
+ public:
+  // from_game: opened by the title's own invite menu (XamShowGameInviteUI). The title waits for
+  // this call to return before it publishes its lobby, so the panel closes right after an invite.
+  FriendsPanel(rex::ui::ImGuiDrawer* d, bool host, bool from_game, int tab)
+      : XamDialog(d), host_(host), from_game_(from_game), tab_(tab), opened_(std::chrono::steady_clock::now()) {}
+
+  void OnDraw(ImGuiIO& io) override {
+    if (g_panel_close.exchange(false) || closing_) { Close(); return; }
+    s_ = std::clamp(io.DisplaySize.y / 1080.0f, 0.7f, 2.5f);
+    const float s = s_;
+    now_ = std::chrono::steady_clock::now();
+    const float t = std::chrono::duration<float>(now_ - opened_).count();
+    in_ = Smooth(t / 0.22f);
+    t_ = t;
+    dl_ = ImGui::GetForegroundDrawList();
+    font_ = SocialFont();
+    W_ = io.DisplaySize.x;
+    H_ = io.DisplaySize.y;
+    io_ = &io;
+    bar_w_ = 660.0f * s;
+    left_ = W_ - bar_w_ + 300.0f * s * (1.0f - in_);
+
+    // darken the right side so the panel reads on any menu / track / arena
+    dl_->AddRectFilledMultiColor(ImVec2(W_ * 0.36f, 0), ImVec2(W_, H_), Col(0, 0, 0, 0.0f), Col(0, 0, 0, 0.76f * in_),
+                                 Col(0, 0, 0, 0.76f * in_), Col(0, 0, 0, 0.0f));
+
+    if (!from_game_) host_ = OnlineSocialHasHostSession();  // lobby opened / left while the panel is up
+    ReadInput();
+    DrawHeader();
+    DrawTabs();
+    const int count = tab_ == 0 ? DrawFriends() : tab_ == 1 ? DrawAchievements() : tab_ == 2 ? DrawServer() : DrawNotices();
+    if (sel_ >= count) sel_ = std::max(0, count - 1);
+    DrawHints();
+    act_ = decline_ = false;
+  }
+
+ private:
+  // ------------------------------------------------------------- input
+  void ReadInput() {
+    move_ = 0;
+    int tab_move = 0;
+    if (ImGui::IsKeyPressed(ImGuiKey_DownArrow)) move_ = 1;
+    if (ImGui::IsKeyPressed(ImGuiKey_UpArrow)) move_ = -1;
+    if (ImGui::IsKeyPressed(ImGuiKey_RightArrow) || ImGui::IsKeyPressed(ImGuiKey_E)) tab_move = 1;
+    if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow) || ImGui::IsKeyPressed(ImGuiKey_Q)) tab_move = -1;
+    act_ = ImGui::IsKeyPressed(ImGuiKey_Enter) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter);
+    decline_ = ImGui::IsKeyPressed(ImGuiKey_Delete);
+    if (ImGui::IsKeyPressed(ImGuiKey_Escape)) closing_ = true;
+    // controller: edges only (buttons held when the panel opened, e.g. Back, are ignored)
+    const PadState pad = ReadPads();
+    pad_ok_ = pad.ok;
+    if (pad.ok) {
+      if (!pad_init_) { pad_init_ = true; prev_ = pad.buttons; }
+      const uint16_t down = uint16_t(pad.buttons & ~prev_);
+      prev_ = pad.buttons;
+      const int stick = pad.ly > 16000 ? -1 : pad.ly < -16000 ? 1 : 0;  // stick up = list up
+      if (stick != stick_dir_) { stick_dir_ = stick; if (stick) { move_ = stick; stick_next_ = now_ + std::chrono::milliseconds(380); } }
+      else if (stick && now_ >= stick_next_) { move_ = stick; stick_next_ = now_ + std::chrono::milliseconds(140); }
+      if (down & kPadDown) move_ = 1;
+      if (down & kPadUp) move_ = -1;
+      if (down & kPadRB) tab_move = 1;
+      if (down & kPadLB) tab_move = -1;
+      if (down & kPadA) act_ = true;
+      if (down & kPadX) decline_ = true;
+      if (down & (kPadB | kPadBack)) closing_ = true;
+    }
+    if (tab_move) { tab_ = (tab_ + tab_move + 4) % 4; sel_ = 0; scroll_ = 0; tab_since_ = now_; }
+    if (tab_ == 3) seen_notices_ = OnlineSocialNotices().size();
+  }
+
+  // ------------------------------------------------------------- header: NOBK.ONLINE + profile card
+  void DrawHeader() {
+    const float s = s_;
+    const float ty = 34.0f * s, big = 46.0f * s;
+    float x = left_ + 8.0f * s;
+    auto put = [&](const char* txt, ImU32 c) {
+      dl_->AddText(font_, big, ImVec2(x + 2 * s, ty + 3 * s), Col(0, 0, 0, 0.6f * in_), txt);
+      dl_->AddText(font_, big, ImVec2(x, ty), c, txt);
+      x += font_->CalcTextSizeA(big, FLT_MAX, 0, txt).x;
+    };
+    put("NOBK", Col(255, 255, 255, in_));
+    put(".", Col(227, 25, 46, in_));
+    put("ONLINE", Col(255, 255, 255, in_));
+    const SocialMe me = OnlineSocialMe();
+    if (me.name.empty()) return;
+    const float r = 29.0f * s;
+    const ImVec2 c(W_ - 36.0f * s - r + 300.0f * s * (1.0f - in_), ty + big * 0.5f + 2 * s);
+    dl_->AddCircleFilled(c, r + 3.0f * s, Col(255, 255, 255, 0.9f * in_), 40);
+    DrawAvatar(dl_, imgui_drawer(), c, r, me.name, me.avatar, 0, in_);
+    const std::string nm = Upper(me.name);
+    std::string sub = me.country.empty() ? "" : me.country + "  -  ";
+    if (me.member_since > 0) {
+      std::time_t tt = std::time_t(me.member_since);
+      std::tm tmv{};
+#if REX_PLATFORM_WIN32
+      gmtime_s(&tmv, &tt);
+#else
+      gmtime_r(&tt, &tmv);
+#endif
+      char b[32];
+      std::strftime(b, sizeof(b), "member since %b %Y", &tmv);
+      sub += b;
+      sub += "  -  ";
+    }
+    sub += std::to_string(me.friends) + (me.friends == 1 ? " friend" : " friends");
+    const float ns = 27.0f * s, ss = 15.0f * s;
+    const float tx = c.x - r - 14.0f * s;
+    float nw = font_->CalcTextSizeA(ns, FLT_MAX, 0, nm.c_str()).x, sw = font_->CalcTextSizeA(ss, FLT_MAX, 0, sub.c_str()).x;
+    dl_->AddText(font_, ns, ImVec2(tx - nw, c.y - ns * 0.62f), Col(255, 255, 255, in_), nm.c_str());
+    dl_->AddText(font_, ss, ImVec2(tx - sw, c.y + 9.0f * s), Col(205, 205, 212, in_), sub.c_str());
+  }
+
+  // ------------------------------------------------------------- tabs (LB / RB)
+  void DrawTabs() {
+    const float s = s_;
+    static const char* names[4] = {"FRIENDS", "ACHIEVEMENTS", "SERVER", "NOTICES"};
+    const float y = 112.0f * s, h = 40.0f * s, chip = 38.0f * s;
+    const float x0 = left_ + chip + 6.0f * s, x1 = W_ - chip - 6.0f * s;
+    const float tw = (x1 - x0) / 4.0f;
+    DrawChip(ImVec2(left_, y + 7 * s), pad_ok_ ? "LB" : "Q");
+    DrawChip(ImVec2(W_ - chip, y + 7 * s), pad_ok_ ? "RB" : "E");
+    const int badges[4] = {int(OnlineSocialPending().size()), 0, 0,
+                           int(OnlineSocialNotices().size()) - int(seen_notices_)};
+    for (int i = 0; i < 4; ++i) {
+      const ImVec2 a(x0 + i * tw + 2 * s, y), b(x0 + (i + 1) * tw - 2 * s, y + h);
+      const bool on = i == tab_;
+      const float sl = 12.0f * s;
+      ImVec2 q[4] = {ImVec2(a.x + sl, a.y), ImVec2(b.x, a.y), ImVec2(b.x - sl, b.y), ImVec2(a.x, b.y)};
+      dl_->AddConvexPolyFilled(q, 4, on ? Col(255, 255, 255, in_) : Col(22, 22, 25, 0.88f * in_));
+      const float fs = 17.0f * s;
+      ImVec2 ts = font_->CalcTextSizeA(fs, FLT_MAX, 0, names[i]);
+      dl_->AddText(font_, fs, ImVec2((a.x + b.x - ts.x) * 0.5f, (a.y + b.y - ts.y) * 0.5f),
+                   on ? Col(17, 17, 17, in_) : Col(190, 190, 196, in_), names[i]);
+      if (badges[i] > 0) {
+        std::string n = std::to_string(badges[i]);
+        ImVec2 bc(b.x - 16.0f * s, a.y + 9.0f * s);
+        dl_->AddCircleFilled(bc, 8.5f * s, Col(227, 25, 46, in_), 20);
+        ImVec2 nt = font_->CalcTextSizeA(12.0f * s, FLT_MAX, 0, n.c_str());
+        dl_->AddText(font_, 12.0f * s, ImVec2(bc.x - nt.x * 0.5f, bc.y - nt.y * 0.5f), Col(255, 255, 255, in_), n.c_str());
+      }
+      if (ImGui::IsMouseClicked(ImGuiMouseButton_Left) && io_->MousePos.x >= a.x && io_->MousePos.x < b.x &&
+          io_->MousePos.y >= a.y && io_->MousePos.y < b.y && tab_ != i) {
+        tab_ = i; sel_ = 0; scroll_ = 0; tab_since_ = now_;
+      }
+    }
+  }
+  void DrawChip(ImVec2 p, const char* txt) {
+    const float s = s_;
+    ImVec2 ts = font_->CalcTextSizeA(14.0f * s, FLT_MAX, 0, txt);
+    dl_->AddRectFilled(p, ImVec2(p.x + 38.0f * s, p.y + 26.0f * s), Col(233, 233, 236, in_), 6.0f * s);
+    dl_->AddText(font_, 14.0f * s, ImVec2(p.x + (38.0f * s - ts.x) * 0.5f, p.y + (26.0f * s - ts.y) * 0.5f), Col(17, 17, 17, in_), txt);
+  }
+
+  // ------------------------------------------------------------- shared bar list
+  // Draws rows [scroll_, ...) that fit; calls row(i, a, b, on, alpha). Returns nothing; handles mouse.
+  template <typename F>
+  void BarList(int count, float row_h, float sel_h, F&& row) {
+    const float s = s_;
+    if (move_ > 0) sel_ = std::min(sel_ + 1, count - 1);
+    if (move_ < 0) sel_ = std::max(sel_ - 1, 0);
+    const float gap = 10.0f * s, top = 172.0f * s, bottom = H_ - 130.0f * s;
+    const int fit = std::max(1, int((bottom - top) / (row_h + gap)));
+    if (sel_ < scroll_) scroll_ = sel_;
+    if (sel_ >= scroll_ + fit) scroll_ = sel_ - fit + 1;
+    const float ts = std::chrono::duration<float>(now_ - tab_since_).count();
+    float y = top;
+    for (int i = scroll_; i < count && i < scroll_ + fit; ++i) {
+      const bool on = i == sel_;
+      const float h = on ? sel_h : row_h;
+      const float slide = 300.0f * s * (1.0f - Smooth((std::min(t_, ts) - 0.03f * (i - scroll_)) / 0.25f));
+      const ImVec2 a(W_ - bar_w_ - (on ? 34.0f * s : 0.0f) + slide, y), b(W_, y + h);
+      if (io_->MousePos.x >= a.x && io_->MousePos.y >= a.y && io_->MousePos.y < b.y) {
+        if (io_->MouseDelta.x != 0 || io_->MouseDelta.y != 0) sel_ = i;
+        if (ImGui::IsMouseClicked(ImGuiMouseButton_Left) && io_->MousePos.y > top) { sel_ = i; act_ = true; }
+      }
+      row(i, a, b, on);
+      y += h + gap;
+    }
+    if (count > scroll_ + fit) {
+      const char* more = "more below";
+      float mw = font_->CalcTextSizeA(16.0f * s, FLT_MAX, 0, more).x;
+      dl_->AddText(font_, 16.0f * s, ImVec2(W_ - 40 * s - mw, y), Col(170, 170, 176, in_), more);
+    }
+  }
+  void PlainBar(ImVec2 a, ImVec2 b, bool on, float al) {
+    const float sl = 26.0f * s_;
+    if (on) Bar(dl_, a, b, sl, Col(255, 255, 255, in_), Col(214, 214, 218, in_));
+    else {
+      Bar(dl_, a, b, sl, Col(44, 44, 48, 0.93f * al), Col(14, 14, 16, 0.93f * al));
+      dl_->AddLine(ImVec2(a.x + sl, a.y), ImVec2(b.x, a.y), Col(255, 255, 255, 0.16f * al), 1.0f);
+    }
+  }
+  void RightText(ImVec2 a, ImVec2 b, const std::string& txt, ImU32 c, float size = 19.0f) {
+    const float rs = size * s_;
+    float rw = font_->CalcTextSizeA(rs, FLT_MAX, 0, txt.c_str()).x;
+    dl_->AddText(font_, rs, ImVec2(W_ - 34.0f * s_ - rw, (a.y + b.y) * 0.5f - rs * 0.5f), c, txt.c_str());
+  }
+
+  // ------------------------------------------------------------- tab 0: friends + invites
+  int DrawFriends() {
+    const float s = s_;
+    struct Row { int kind; SocialInvite inv; SocialFriend f; };  // kind 0 = invite, 1 = friend
+    std::vector<Row> rows;
+    for (auto& inv : OnlineSocialPending()) rows.push_back({0, inv, {}});
+    auto friends = OnlineSocialFriends();
+    std::stable_sort(friends.begin(), friends.end(), [](const SocialFriend& a, const SocialFriend& b) {
+      return (a.online ? (a.playing ? 1 : 0) : 2) < (b.online ? (b.playing ? 1 : 0) : 2);
+    });
+    for (auto& f : friends) {  // a friend who invited you shows once: as the red invite bar
+      bool has_invite = std::any_of(rows.begin(), rows.end(), [&](const Row& x) { return x.kind == 0 && x.inv.from == f.name; });
+      if (!has_invite) rows.push_back({1, {}, f});
+    }
+    const int n = int(rows.size());
+    if (sel_ >= n) sel_ = std::max(0, n - 1);
+    sel_kind_ = n ? rows[sel_].kind : 1;
+    if (!n) {
+      const ImVec2 a(W_ - bar_w_, 172.0f * s), b(W_, 172.0f * s + 62.0f * s);
+      PlainBar(a, b, false, in_);
+      dl_->AddText(font_, 22.0f * s, ImVec2(a.x + 50 * s, a.y + 20 * s), Col(220, 220, 225, in_),
+                   "No friends yet - add friends on nobkonline.com");
+    }
+    BarList(n, 62.0f * s, 72.0f * s, [&](int i, ImVec2 a, ImVec2 b, bool on) {
+      const Row& r = rows[i];
+      const bool offline = r.kind == 1 && !r.f.online;
+      const float al = in_ * (offline && !on ? 0.5f : 1.0f);
+      ImU32 tc = Col(255, 255, 255, al), sc = Col(175, 175, 182, al);
+      if (r.kind == 0) {
+        Bar(dl_, a, b, 26.0f * s, Col(232, 36, 56, in_), Col(170, 14, 30, in_));
+        if (on) dl_->AddRect(ImVec2(a.x + 13.0f * s, a.y), b, Col(255, 255, 255, in_), 0, 0, 3.0f * s);
+        sc = Col(255, 255, 255, in_);
+      } else {
+        PlainBar(a, b, on, al);
+        if (on) { tc = Col(17, 17, 17, in_); sc = Col(196, 15, 34, in_); }
+      }
+      const std::string name = r.kind == 0 ? r.inv.from : r.f.name;
+      ImU32 dot = r.kind == 0 ? Col(61, 220, 132) : !r.f.online ? Col(120, 120, 126) : r.f.playing ? Col(245, 192, 75) : Col(61, 220, 132);
+      const float ar = 23.0f * s * (on ? 1.08f : 1.0f);
+      DrawAvatar(dl_, imgui_drawer(), ImVec2(a.x + 52.0f * s + ar, (a.y + b.y) * 0.5f), ar, name,
+                 r.kind == 0 ? r.inv.avatar : r.f.avatar, dot, al);
+      const float nx = a.x + 52.0f * s + ar * 2 + 18.0f * s, ns = (on ? 31.0f : 28.0f) * s;
+      const std::string up = Upper(name);
+      dl_->AddText(font_, ns, ImVec2(nx, (a.y + b.y) * 0.5f - ns * 0.55f), tc, up.c_str());
+      if (r.kind == 1 && !r.f.country.empty()) {
+        float nw = font_->CalcTextSizeA(ns, FLT_MAX, 0, up.c_str()).x;
+        dl_->AddText(font_, 15.0f * s, ImVec2(nx + nw + 10 * s, (a.y + b.y) * 0.5f - 6 * s),
+                     on ? Col(110, 110, 116, in_) : Col(140, 140, 148, al), r.f.country.c_str());
+      }
+      bool invited = false;
+      if (r.kind == 1) {
+        std::lock_guard<std::mutex> lock(g_invited_mutex);
+        auto it = g_invited.find(r.f.name);
+        invited = it != g_invited.end() && now_ - it->second < std::chrono::seconds(30);
+      }
+      std::string rt;
+      if (r.kind == 0) rt = on ? (pad_ok_ ? "invited you  -  A join  -  X decline" : "invited you  -  Enter to join") : "invited you to a match";
+      else if (!r.f.online) rt = "Offline";
+      else if (r.f.playing) rt = "In a match";
+      else if (invited) rt = host_ ? "Invited" : "Joining...";
+      else if (r.f.joinable && !host_) rt = on ? (pad_ok_ ? "A  -  join lobby" : "Enter  -  join lobby") : "Open lobby  -  join";
+      else if (host_) rt = on ? (pad_ok_ ? "A  -  invite" : "Enter  -  invite") : "Online";
+      else rt = "Online  -  in menus";
+      RightText(a, b, rt, sc);
+    });
+    if (n && act_) {
+      const Row& r = rows[sel_];
+      if (r.kind == 0) {
+        OnlineSocialAccept(r.inv.id);
+        closing_ = true;
+      } else if (host_ && r.f.online && !r.f.playing) {
+        bool again = false;
+        {
+          std::lock_guard<std::mutex> lock(g_invited_mutex);
+          auto it = g_invited.find(r.f.name);
+          again = it != g_invited.end() && now_ - it->second < std::chrono::seconds(30);
+          if (!again) g_invited[r.f.name] = now_;
+        }
+        if (!again) OnlineSocialSendInvite({r.f.name});
+        if (from_game_) closing_ = true;
+      } else if (r.f.joinable && r.f.online && !r.f.playing) {
+        bool again = false;
+        {
+          std::lock_guard<std::mutex> lock(g_invited_mutex);
+          auto it = g_invited.find(r.f.name);
+          again = it != g_invited.end() && now_ - it->second < std::chrono::seconds(10);
+          if (!again) g_invited[r.f.name] = now_;
+        }
+        if (!again) OnlineSocialJoin(r.f.name);
+        closing_ = true;
+      }
+    }
+    if (n && decline_ && rows[sel_].kind == 0) OnlineSocialDecline(rows[sel_].inv.id);
+    if (!host_) {
+      const char* hint = "Join a friend's open lobby, or create one (Play a Friend) to invite";
+      float hw = font_->CalcTextSizeA(16.0f * s, FLT_MAX, 0, hint).x;
+      dl_->AddText(font_, 16.0f * s, ImVec2(W_ - 36.0f * s - hw, 158.0f * s), Col(190, 190, 196, in_), hint);
+    }
+    return n;
+  }
+
+  // ------------------------------------------------------------- tab 1: achievements (was F7)
+  int DrawAchievements() {
+    const float s = s_;
+    auto* ks = REX_KERNEL_STATE();
+    if (!ks) return 0;
+    auto& am = ks->achievements();
+    auto list = am.ListAchievements();
+    // unlocked first (newest first), then locked in the title's order
+    std::vector<std::pair<rex::system::AchievementInfo, uint64_t>> rows;
+    for (auto& a : list) rows.push_back({a, am.IsUnlocked(a.id) ? am.GetUnlockTime(a.id) : 0});
+    std::stable_sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+      if ((a.second != 0) != (b.second != 0)) return a.second != 0;
+      return a.second > b.second;
+    });
+    int unlocked = 0;
+    uint32_t score = 0, total = 0;
+    for (auto& r : rows) { total += r.first.gamerscore; if (r.second) { ++unlocked; score += r.first.gamerscore; } }
+    // progress bar
+    const float py = 160.0f * s;
+    const ImVec2 pa(W_ - bar_w_ + 30.0f * s, py), pb(W_ - 30.0f * s, py + 6.0f * s);
+    dl_->AddRectFilled(pa, pb, Col(255, 255, 255, 0.15f * in_));
+    if (!rows.empty())
+      dl_->AddRectFilled(pa, ImVec2(pa.x + (pb.x - pa.x) * float(unlocked) / float(rows.size()), pb.y), Col(227, 25, 46, in_));
+    std::string sum = std::to_string(unlocked) + " / " + std::to_string(rows.size()) + "  -  " + std::to_string(score) + " / " + std::to_string(total) + " G";
+    float sw = font_->CalcTextSizeA(15.0f * s, FLT_MAX, 0, sum.c_str()).x;
+    dl_->AddText(font_, 15.0f * s, ImVec2(W_ - 30.0f * s - sw, py - 22.0f * s), Col(205, 205, 212, in_), sum.c_str());
+    if (!icons_ && imgui_drawer() && imgui_drawer()->immediate_drawer() && ks->emulator())
+      icons_ = std::make_unique<rex::ui::AchievementIconCache>(imgui_drawer()->immediate_drawer(), const_cast<Runtime*>(ks->emulator()));
+    BarList(int(rows.size()), 62.0f * s, 70.0f * s, [&](int i, ImVec2 a, ImVec2 b, bool on) {
+      const auto& info = rows[i].first;
+      const bool got = rows[i].second != 0;
