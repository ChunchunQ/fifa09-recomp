+// ---------------------------------------------------------------- invite notification (top right, 10 s)
+class InviteToast : public rex::ui::ImGuiDialog {
+ public:
+  explicit InviteToast(rex::ui::ImGuiDrawer* d) : rex::ui::ImGuiDialog(d) {}
+  struct Item {
+    uint32_t id = 0;   // invite id, or 0x80000000 | notice id
+    int kind = 0;      // 0 invite, 1 notice from NOBK, 2 invite declined
+    std::string who, avatar, text;
+  };
+  static std::mutex mutex;
+  static std::deque<Item> queue;
+  static InviteToast* instance;  // UI thread only
+
+  void OnDraw(ImGuiIO& io) override {
+    Item cur;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (queue.empty()) { instance = nullptr; Close(); return; }
+      cur = queue.front();
+      if (started_ && cur.id != shown_id_) started_ = false;  // the shown one was answered
+      shown_id_ = cur.id;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (!started_) { started_ = true; since_ = now; PlayInviteSound(); }
+    const float age = std::chrono::duration<float>(now - since_).count();
+    if (age > kTotal) {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (!queue.empty()) queue.pop_front();
+      started_ = false;
+      return;
+    }
+    const float s = std::clamp(io.DisplaySize.y / 1080.0f, 0.7f, 2.5f);
+    const float in = Smooth(age / 0.3f), out = 1.0f - Smooth((age - (kTotal - 0.35f)) / 0.35f);
+    const float alpha = in * out;
+    const float w = 470.0f * s, h = 104.0f * s;
+    const float x1 = io.DisplaySize.x - 28.0f * s + (1.0f - in) * (w + 40 * s);
+    const ImVec2 a(x1 - w, 28.0f * s), b(x1, 28.0f * s + h);
+    ImDrawList* dl = ImGui::GetForegroundDrawList();
+    ImFont* font = SocialFont();
+    dl->AddRectFilled(ImVec2(a.x + 4 * s, a.y + 6 * s), ImVec2(b.x + 4 * s, b.y + 6 * s), Col(0, 0, 0, 0.35f * alpha), 14 * s);
+    dl->AddRectFilled(a, b, Col(18, 18, 22, 0.95f * alpha), 14 * s);
+    dl->AddRect(a, b, Col(255, 255, 255, 0.12f * alpha), 14 * s, 0, 1.0f);
+    dl->AddRectFilled(a, ImVec2(a.x + 5 * s, b.y), Col(227, 25, 46, alpha), 14 * s, ImDrawFlags_RoundCornersLeft);
+    const ImU32 accent = cur.kind == 0 ? Col(227, 25, 46, alpha) : cur.kind == 1 ? Col(245, 192, 75, alpha) : Col(150, 150, 158, alpha);
+    const float r = 31.0f * s;
+    const ImVec2 ac(a.x + 22 * s + r, (a.y + b.y) * 0.5f);
+    if (cur.kind == 1) {
+      dl->AddCircleFilled(ac, r, accent, 40);
+      ImVec2 ts = font->CalcTextSizeA(r * 1.3f, FLT_MAX, 0, "!");
+      dl->AddText(font, r * 1.3f, ImVec2(ac.x - ts.x * 0.5f, ac.y - ts.y * 0.5f), Col(42, 29, 5, alpha), "!");
+    } else {
+      DrawAvatar(dl, imgui_drawer(), ac, r, cur.who, cur.avatar, cur.kind == 0 ? Col(61, 220, 132) : 0, alpha);
+    }
+    const float tx = a.x + 22 * s + r * 2 + 16 * s;
+    const char* title = cur.kind == 0 ? "MATCH INVITE" : cur.kind == 1 ? "NOBK.ONLINE NOTICE" : "INVITE";
+    dl->AddText(font, 15.0f * s, ImVec2(tx, a.y + 16 * s), accent, title);
+    const std::string line = cur.kind == 0 ? cur.who + " invited you to a match" : cur.text;
+    dl->PushClipRect(ImVec2(tx, a.y), ImVec2(b.x - 12 * s, b.y), true);
+    dl->AddText(font, 22.0f * s, ImVec2(tx, a.y + 36 * s), Col(255, 255, 255, alpha), line.c_str());
+    dl->PopClipRect();
+    if (cur.kind == 0)
+      DrawKey(dl, ImVec2(tx, a.y + 67 * s), s * 0.9f, ReadPads().ok ? "hold BACK" : "F1", "to answer", alpha);
+    const float left = 1.0f - age / kTotal;
+    dl->AddRectFilled(ImVec2(a.x + 6 * s, b.y - 4 * s), ImVec2(a.x + 6 * s + (w - 12 * s) * std::max(0.0f, left), b.y - 1 * s),
+                      accent, 2 * s);
+  }
+
+ private:
+  static constexpr float kTotal = 10.0f;
+  bool started_ = false;
+  uint32_t shown_id_ = 0;
+  std::chrono::steady_clock::time_point since_;
+};
+std::mutex InviteToast::mutex;
+std::deque<InviteToast::Item> InviteToast::queue;
+InviteToast* InviteToast::instance = nullptr;
+
+static void PushToast(InviteToast::Item item) {
+  {
+    std::lock_guard<std::mutex> lock(InviteToast::mutex);
+    if (InviteToast::queue.size() >= 3) return;  // never a wall of notifications
+    InviteToast::queue.push_back(std::move(item));
+  }
+  const Runtime* emulator = REX_KERNEL_STATE() ? REX_KERNEL_STATE()->emulator() : nullptr;
+  ui::ImGuiDrawer* drawer = emulator ? emulator->imgui_drawer() : nullptr;
+  if (!drawer || REXCVAR_GET(headless) || !emulator->app_context()) return;
+  emulator->app_context()->CallInUIThreadDeferred([drawer]() {
+    if (!InviteToast::instance) InviteToast::instance = new InviteToast(drawer);
+  });
+}
+
+void OnlineSocialToast(const SocialInvite& inv) {
+  OnlineSocialAvatar(inv.avatar, nullptr);  // start the picture download
+  PushToast({inv.id, 0, inv.from, inv.avatar, ""});
+}
+
+void OnlineSocialNotice(uint32_t id, int kind, const std::string& text) {
+  PushToast({0x80000000u | id, kind == 1 ? 2 : 1, "", "", text});
+}
+
+// Hold Back for 0.7 s (window in front) to open or close the friends panel. A short press goes to the
+// title as usual, so its own use of Back is not affected.
+void OnlineSocialStartPadWatch() {
+  static std::atomic<bool> started{false};
+  if (started.exchange(true)) return;
+  std::thread([] {
+    auto since = std::chrono::steady_clock::time_point();
+    bool held = false, fired = false;
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(30));
+      if (g_panel_open) { held = false; fired = true; continue; }  // the panel reads the pad itself
+      const PadState p = ReadPads();
+      const bool back = p.ok && (p.buttons & kPadBack) && OurWindowFocused();
+      if (!back) { held = false; fired = false; continue; }
+      const auto now = std::chrono::steady_clock::now();
+      if (!held) { held = true; since = now; }
+      if (!fired && now - since >= std::chrono::milliseconds(700)) {
+        fired = true;
+        REXKRNL_INFO("[social] Back held: opening the friends panel");
+        OnlineSocialOpenGuide();
+      }
+    }
+  }).detach();
+}
+
+void OnlineSocialToastDismiss(uint32_t id) {
+  std::lock_guard<std::mutex> lock(InviteToast::mutex);
+  auto& q = InviteToast::queue;
+  q.erase(std::remove_if(q.begin(), q.end(), [id](const InviteToast::Item& x) { return x.id == id; }), q.end());
+}
+
+static X_RESULT ShowFriendsPanel(bool host, bool from_game, int tab = 0) {
+  const Runtime* emulator = REX_KERNEL_STATE() ? REX_KERNEL_STATE()->emulator() : nullptr;
+  ui::ImGuiDrawer* drawer = emulator ? emulator->imgui_drawer() : nullptr;
+  if (!drawer || REXCVAR_GET(headless)) return X_ERROR_SUCCESS;
+  if (g_panel_open.exchange(true)) return X_ERROR_SUCCESS;
+  g_panel_close = false;
+  OnlineSocialPoll();  // fresh friends / host state right away
+  for (auto& f : OnlineSocialFriends()) OnlineSocialAvatar(f.avatar, nullptr);  // start downloads
+  for (auto& i : OnlineSocialPending()) OnlineSocialAvatar(i.avatar, nullptr);
+  REXKRNL_INFO("[social] friends panel opened (host session: {})", host);
+  auto close = [](FriendsPanel*) -> X_RESULT { return X_ERROR_SUCCESS; };
+  X_RESULT r = xeXamDispatchDialog<FriendsPanel>(new FriendsPanel(drawer, host, from_game, tab), close, 0);
+  g_panel_open = false;
+  return r;
+}
+
+u32 XamShowGameInviteUI_entry(u32 user_index, mapped_void recipients, u32 count, mapped_void text) {
+  REXKRNL_INFO("[social] XamShowGameInviteUI(user={}, recipients={})", uint32_t(user_index), uint32_t(count));
+  // the title's own invite menu only opens from its lobby: the player hosts it
+  return ShowFriendsPanel(true, true);
+}
+
+// F1 from anywhere: opens the panel (on its own thread: the dispatch waits for the UI
+// thread, which is where the key press arrives); pressed again while open: closes it.
+void OnlineSocialOpenGuide() {
+  if (g_panel_open) { g_panel_close = true; return; }
+  std::thread([] { ShowFriendsPanel(OnlineSocialHasHostSession(), false); }).detach();
+}
+
+// F7 (was the SDK's achievements overlay): the panel on its Achievements tab.
+void OnlineSocialOpenAchievements() {
+  if (g_panel_open) { g_panel_close = true; return; }
+  std::thread([] { ShowFriendsPanel(OnlineSocialHasHostSession(), false, 1); }).detach();
+}
