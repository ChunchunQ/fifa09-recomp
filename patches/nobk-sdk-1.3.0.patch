+
+// Sends `data` to virtual `to` through the relay. Returns bytes of game data
+// sent (len) or -1.
+static int RelaySend(XSocket* sock, const uint8_t* data, uint32_t len, uint32_t flags,
+                     const N_XSOCKADDR_IN* to, uint8_t type = 1) {
+  const RelayConfig& r = Relay();
+  std::vector<uint8_t> pkt(kRelayHdr + len);
+  pkt[0] = 'R';
+  pkt[1] = 'L';
+  pkt[2] = 1;
+  pkt[3] = type;
+  uint32_t vip = OwnVirtualIpNBO();
+  std::memcpy(&pkt[4], &vip, 4);
+  SetRawPort(&pkt[8], LogicalLocalPort(sock->native_handle()));
+  if (to) {
+    std::memcpy(&pkt[10], &to->sin_addr, 4);
+    std::memcpy(&pkt[14], &to->sin_port, 2);
+  }
+  if (len) std::memcpy(&pkt[kRelayHdr], data, len);
+  P2PStart(r.addr_nbo, r.port, vip);
+  bool also_relay = true;
+  if (type == 1 && to) {
+    for (const sockaddr_in& d : P2PTargets(RawPort(&to->sin_port), &also_relay)) {
+      N_XSOCKADDR_IN direct;
+      direct.sin_family = AF_INET;
+      std::memcpy(&direct.sin_addr, &d.sin_addr.s_addr, 4);
+      std::memcpy(&direct.sin_port, &d.sin_port, 2);
+      std::memset(direct.x_sin_zero, 0, sizeof(direct.x_sin_zero));
+      int dret = sock->SendTo(pkt.data(), uint32_t(pkt.size()), flags, &direct, 16);
+      LogSendOnce("p2p", &direct.sin_addr, &direct.sin_port, dret);
+    }
+    if (!also_relay) return int(len);
+  }
+  N_XSOCKADDR_IN relay_to;
+  relay_to.sin_family = AF_INET;
+  std::memcpy(&relay_to.sin_addr, &r.addr_nbo, 4);
+  SetRawPort(&relay_to.sin_port, r.port);
+  std::memset(relay_to.x_sin_zero, 0, sizeof(relay_to.x_sin_zero));
+  int ret = sock->SendTo(pkt.data(), uint32_t(pkt.size()), flags, &relay_to, 16);
+  if (type == 1) LogRelayPacket("out", pkt.data(), pkt.data() + kRelayHdr, len);
+  if (to) LogSendOnce("relay", &to->sin_addr, &to->sin_port, ret);
+  return ret < 0 ? -1 : int(len);
+}
+
+// [online] Hex dump of the first relayed match packets in each direction, to
+// debug the game-link handshake.
+static void LogRelayPacket(const char* dir, const uint8_t* hdr, const uint8_t* payload, size_t n) {
+  static std::atomic<int> s_count{0};
+  if (s_count++ >= 120) return;
+  std::string hex;
+  char t[4];
+  for (size_t i = 0; i < n && i < 48; ++i) {
+    std::snprintf(t, sizeof(t), "%02x", payload[i]);
+    hex += t;
+    if ((i & 3) == 3) hex += ' ';
+  }
+  REXKRNL_INFO("[relay-pkt] {} {}.{}.{}.{}:{} -> {}.{}.{}.{}:{} len={} [{}]", dir, hdr[4], hdr[5],
+               hdr[6], hdr[7], (hdr[8] << 8) | hdr[9], hdr[10], hdr[11], hdr[12], hdr[13],
+               (hdr[14] << 8) | hdr[15], n, hex);
+}
+
+// If `data` is a relayed packet from the relay, returns the payload offset and
+// fills `from` with the virtual sender; otherwise returns 0.
+static size_t RelayUnwrap(const uint8_t* data, size_t n, const sockaddr_in& src,
+                          N_XSOCKADDR_IN* from) {
+  const RelayConfig& r = Relay();
+  if (!r.enabled || n < kRelayHdr) return 0;
+  if (data[0] != 'R' || data[1] != 'L' || data[2] != 1 || data[3] != 1) return 0;
+  const bool from_relay = src.sin_addr.s_addr == r.addr_nbo && ntohs(src.sin_port) == r.port;
+  if (!from_relay && !P2PAccept(src, RawPort(data + 8))) return 0;
+  std::memcpy(&from->sin_addr, data + 4, 4);
+  std::memcpy(&from->sin_port, data + 8, 2);
+  LogRelayPacket("in ", data, data + kRelayHdr, n - kRelayHdr);
+  return kRelayHdr;
+}
+
+// [online] Once-a-second UDP traffic summary per game port (always on while
+// online), so a dropped match shows whether packets stopped flowing.
+struct UdpPortStats {
+  uint32_t sent = 0, recv = 0, sent_bytes = 0, recv_bytes = 0;
+};
+static std::mutex g_udp_stats_mutex;
+static std::map<uint16_t, UdpPortStats> g_udp_stats;
+static std::chrono::steady_clock::time_point g_udp_stats_last;
+
+static void UdpStatsFlushLocked() {
+  auto now = std::chrono::steady_clock::now();
+  if (now - g_udp_stats_last < std::chrono::seconds(1)) return;
+  g_udp_stats_last = now;
+  if (g_udp_stats.empty()) return;
+  std::string line;
+  for (auto& [port, st] : g_udp_stats) {
+    char b[96];
+    std::snprintf(b, sizeof(b), " %u: out %u (%uB) in %u (%uB) |", port, st.sent, st.sent_bytes,
+                  st.recv, st.recv_bytes);
+    line += b;
+  }
+  g_udp_stats.clear();
+  REXKRNL_INFO("[udp-stats]{}", line);
+}
+static void UdpStatsCount(uint16_t port, bool out, uint32_t bytes) {
+  if (!OnlineFeature("link")) return;
+  std::lock_guard<std::mutex> lock(g_udp_stats_mutex);
+  auto& st = g_udp_stats[port];
+  if (out) { st.sent++; st.sent_bytes += bytes; } else { st.recv++; st.recv_bytes += bytes; }
+  UdpStatsFlushLocked();
+}
