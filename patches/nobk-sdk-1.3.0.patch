+    auto note = [&](double hz, double secs) {
+      const int n = int(rate * secs);
+      for (int i = 0; i < n; ++i) {
+        const double t = double(i) / rate, env = std::min(1.0, t * 60.0) * std::exp(-t * 9.0);
+        pcm.push_back(int16_t(9000.0 * env * (std::sin(6.2831853 * hz * t) + 0.3 * std::sin(6.2831853 * hz * 2 * t))));
+      }
+    };
+    note(784.0, 0.11);
+    note(1175.0, 0.28);
+    const uint32_t data = uint32_t(pcm.size() * 2);
+    auto u32 = [&](uint32_t v) { for (int i = 0; i < 4; ++i) wav.push_back(uint8_t(v >> (8 * i))); };
+    auto u16 = [&](uint16_t v) { wav.push_back(uint8_t(v)); wav.push_back(uint8_t(v >> 8)); };
+    for (char c : std::string("RIFF")) wav.push_back(uint8_t(c));
+    u32(36 + data);
+    for (char c : std::string("WAVEfmt ")) wav.push_back(uint8_t(c));
+    u32(16); u16(1); u16(1); u32(rate); u32(rate * 2); u16(2); u16(16);
+    for (char c : std::string("data")) wav.push_back(uint8_t(c));
+    u32(data);
+    const uint8_t* b = reinterpret_cast<const uint8_t*>(pcm.data());
+    wav.insert(wav.end(), b, b + data);
+  }
+  if (!file.empty())
+    PlaySoundW(file.c_str(), nullptr, SND_FILENAME | SND_ASYNC | SND_NODEFAULT);
+  else
+    PlaySoundW(reinterpret_cast<LPCWSTR>(wav.data()), nullptr, SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
+#endif
+}
