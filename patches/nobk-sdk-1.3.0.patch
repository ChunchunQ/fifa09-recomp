+struct AvatarCache {
+  std::map<std::string, std::unique_ptr<rex::ui::ImmediateTexture>> tex;
+  std::set<std::string> bad;
+  rex::ui::ImmediateTexture* Get(rex::ui::ImGuiDrawer* drawer, const std::string& path) {
+    if (path.empty() || bad.count(path) || !drawer || !drawer->immediate_drawer()) return nullptr;
+    auto it = tex.find(path);
+    if (it != tex.end()) return it->second.get();
+    std::vector<uint8_t> png;
+    if (!OnlineSocialAvatar(path, &png)) return nullptr;
+    int w = 0, h = 0;
+    auto rgba = rex::ui::DecodeImageRGBA(png.data(), png.size(), w, h);
+    if (rgba.empty() || w <= 0 || h <= 0) { bad.insert(path); return nullptr; }
+    auto t = drawer->immediate_drawer()->CreateTexture(uint32_t(w), uint32_t(h),
+                                                       rex::ui::ImmediateTextureFilter::kLinear, false, rgba.data());
+    auto* raw = t.get();
+    tex[path] = std::move(t);
+    return raw;
+  }
+};
