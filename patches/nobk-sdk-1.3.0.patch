+  uint32_t ip = htonl(INADDR_LOOPBACK);
+  if (::connect(s, reinterpret_cast<sockaddr*>(&probe), sizeof(probe)) == 0) {
+    sockaddr_in local = {};
+    int len = static_cast<int>(sizeof(local));
+    if (::getsockname(s, reinterpret_cast<sockaddr*>(&local), &len) == 0 &&
