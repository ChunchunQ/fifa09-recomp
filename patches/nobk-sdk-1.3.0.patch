+  const size_t n = std::min<size_t>(len, 16);
+  size_t off = 0;
+  for (size_t i = 0; i < n && off + 3 < out_sz; ++i) {
+    off += std::snprintf(out + off, out_sz - off, "%02x ", p[i]);
+  }
+  if (off > 0 && out[off - 1] == ' ') out[off - 1] = 0;
+  else if (off < out_sz) out[off] = 0;
