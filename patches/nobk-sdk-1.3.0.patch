+// ---------------------------------------------------------------------------
+// [online] Friends + game invites (online_social.h). Own UDP socket to the relay.
+static std::mutex g_soc_mutex;
+static std::vector<SocialFriend> g_soc_friends;
+static std::vector<SocialInvite> g_soc_pending;          // received, not answered yet
+static std::set<uint32_t> g_soc_shown;                    // invite ids already shown
+static std::vector<std::string> g_soc_queue;              // requests waiting to be sent
+static uint8_t g_soc_host_info[60] = {};
+static bool g_soc_host_valid = false;
+static uint8_t g_soc_accepted[84] = {};
+static bool g_soc_accepted_valid = false;
+static std::atomic<bool> g_soc_started{false};
+static SocialMe g_soc_me;
+static int g_soc_hosting = -1;  // server: hosting an open lobby (1/0), -1 = server does not say
+static SocialServer g_soc_srv;
+static std::vector<SocialNoticeLog> g_soc_notice_log;
+static std::set<uint32_t> g_soc_notes_shown;              // notice ids already shown
+static std::set<uint32_t> g_soc_answered;                 // invites answered here (hidden from the panel)
+static std::map<uint32_t, std::chrono::steady_clock::time_point> g_soc_seen;  // first time an invite arrived
+static std::map<std::string, std::vector<uint8_t>> g_soc_avatars;  // path -> PNG bytes (empty = failed)
+static std::set<std::string> g_soc_avatar_want;                     // paths waiting for the download thread
+
+static std::string SocHex(const uint8_t* p, size_t n) {
+  static const char* d = "0123456789ABCDEF";
+  std::string o;
+  for (size_t i = 0; i < n; ++i) { o += d[p[i] >> 4]; o += d[p[i] & 15]; }
+  return o;
+}
+static bool SocUnhex(const std::string& h, uint8_t* out, size_t n) {
+  if (h.size() != n * 2) return false;
+  auto v = [](char c) -> int {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    return -1;
+  };
+  for (size_t i = 0; i < n; ++i) {
+    int a = v(h[2 * i]), b = v(h[2 * i + 1]);
+    if (a < 0 || b < 0) return false;
+    out[i] = uint8_t(a * 16 + b);
+  }
+  return true;
+}
+static bool SocNameOk(const std::string& n) {
+  if (n.empty() || n.size() > 24) return false;
+  for (char c : n)
+    if (!(std::isalnum(static_cast<unsigned char>(c)) || c == '_' || c == '-' || c == '.')) return false;
+  return true;
+}
+
+struct SocNote { uint32_t id; int kind; std::string text; };
+static std::vector<SocNote> g_soc_new_notes;  // filled by SocApply, shown by the social thread
+static std::vector<SocialInvite> g_soc_join_ready;  // "A" lines: join answers, accepted by the social thread
+
+static void SocApply(const std::string& text, std::vector<SocialInvite>* fresh) {
+  std::vector<SocialFriend> friends;
+  std::vector<SocNote> notes;
+  std::vector<SocialInvite> invites;
+  size_t pos = 0;
+  bool first = true;
+  while (pos < text.size()) {
+    size_t eol = text.find('\n', pos);
+    std::string line = text.substr(pos, eol == std::string::npos ? std::string::npos : eol - pos);
+    pos = eol == std::string::npos ? text.size() : eol + 1;
+    if (first) { first = false; if (line != "SOC1") return; continue; }
+    char kind = 0, name[40] = {}, hex[130] = {}, av[200] = {}, cc[8] = {};
+    unsigned a = 0, b = 0, j = 0;
+    unsigned long long x = 0;
+    // extra fields (newer servers): avatar path ("-" = none) and country
+    auto clean_av = [](const char* p) -> std::string {
+      std::string v = p;
+      return (v.rfind("/api/avatar/", 0) == 0 && v.size() < 120) ? v : std::string();
+    };
+    if (line.size() > 2 && line[0] == 'F' &&
+        std::sscanf(line.c_str(), "%c %u %u %llx %39s %199s %7s %u", &kind, &a, &b, &x, name, av, cc, &j) >= 5 &&
+        SocNameOk(name)) {
+      SocialFriend f{name, x, a != 0, b != 0};
+      f.avatar = clean_av(av);
+      if (std::strlen(cc) == 2) f.country = cc;
+      f.joinable = j == 1;
+      friends.push_back(f);
+    } else if (line.size() > 2 && line[0] == 'M') {
+      char mav[200] = {}, mcc[8] = {};
+      long long since = 0;
+      int nf = 0;
+      if (std::sscanf(line.c_str(), "M %39s %199s %7s %lld %d", name, mav, mcc, &since, &nf) >= 1 && SocNameOk(name)) {
+        SocialMe m;
+        m.name = name;
+        m.avatar = clean_av(mav);
+        if (std::strlen(mcc) == 2) m.country = mcc;
+        m.member_since = since;
+        m.friends = nf;
+        std::lock_guard<std::mutex> lock(g_soc_mutex);
+        g_soc_me = m;
+      }
+    } else if (line.size() >= 3 && line[0] == 'H' && line[1] == ' ') {
+      std::lock_guard<std::mutex> lock(g_soc_mutex);
+      g_soc_hosting = line[2] == '1' ? 1 : 0;
+    } else if (line.size() > 2 && line[0] == 'S') {
+      int on = 0, se = 0, lv = 0;
+      if (std::sscanf(line.c_str(), "S %d %d %d", &on, &se, &lv) == 3) {
+        std::lock_guard<std::mutex> lock(g_soc_mutex);
+        g_soc_srv.have = true;
+        g_soc_srv.online = on;
+        g_soc_srv.searching = se;
+        g_soc_srv.live = lv;
+      }
+    } else if (line.size() > 4 && line[0] == 'N') {
+      unsigned nid = 0, nk = 0;
+      int used = 0;
+      if (std::sscanf(line.c_str(), "N %u %u %n", &nid, &nk, &used) >= 2 && used > 0 && size_t(used) <= line.size()) {
+        std::string t = line.substr(size_t(used));
+        for (auto& c : t) if (static_cast<unsigned char>(c) < 32) c = ' ';
+        if (!t.empty() && t.size() <= 160) notes.push_back({nid, int(nk), t});
+      }
+    } else if (line.size() > 2 && line[0] == 'I' &&
+               std::sscanf(line.c_str(), "%c %u %llx %39s %129s %199s", &kind, &a, &x, name, hex, av) >= 5 &&
+               SocNameOk(name)) {
+      SocialInvite inv;
+      inv.id = a;
+      inv.from_xuid = x;
+      inv.from = name;
+      inv.avatar = clean_av(av);
+      if (SocUnhex(hex, inv.info, 60)) invites.push_back(inv);
+    } else if (line.size() > 2 && line[0] == 'A' &&
+               std::sscanf(line.c_str(), "%c %u %llx %39s %129s", &kind, &a, &x, name, hex) == 5 && SocNameOk(name)) {
+      SocialInvite inv;  // join answer: the host's session, accepted right away
+      inv.id = a;
+      inv.from_xuid = x;
+      inv.from = name;
+      if (SocUnhex(hex, inv.info, 60)) {
+        std::lock_guard<std::mutex> lock(g_soc_mutex);
+        if (!g_soc_shown.count(inv.id) && !g_soc_answered.count(inv.id)) {
+          g_soc_shown.insert(inv.id);
+          g_soc_join_ready.push_back(inv);
+        }
+      }
+    }
+  }
+  std::lock_guard<std::mutex> lock(g_soc_mutex);
+  g_soc_friends.swap(friends);
+  for (auto& inv : invites)
+    if (!g_soc_shown.count(inv.id)) {
+      g_soc_shown.insert(inv.id);
+      g_soc_seen[inv.id] = std::chrono::steady_clock::now();
+      fresh->push_back(inv);
+    }
+  for (auto& n : notes)
+    if (!g_soc_notes_shown.count(n.id)) {
+      g_soc_notes_shown.insert(n.id);
+      g_soc_new_notes.push_back(n);
+      g_soc_notice_log.insert(g_soc_notice_log.begin(), {n.id, n.kind, n.text, int64_t(std::time(nullptr))});
+      if (g_soc_notice_log.size() > 30) g_soc_notice_log.pop_back();
+    }
+  g_soc_pending.swap(invites);
+}
+
+static void SocialThread() {
+#if REX_PLATFORM_WIN32
+  const RelayConfig& r = Relay();
+  SOCKET s = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (s == INVALID_SOCKET) { REXKRNL_WARN("[social] no socket; friends/invites off"); return; }
+  DWORD tmo = 500;
+  ::setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&tmo), sizeof(tmo));
+  sockaddr_in relay = {};
+  relay.sin_family = AF_INET;
+  relay.sin_addr.s_addr = r.addr_nbo;
+  relay.sin_port = htons(r.port);
+  REXKRNL_INFO("[social] friends + invites channel started");
+  auto send = [&](const std::string& body) {
+    uint32_t vip = OwnVirtualIpNBO();
+    std::vector<uint8_t> pkt(kRelayHdr + body.size(), 0);
+    pkt[0] = 'R'; pkt[1] = 'L'; pkt[2] = 1; pkt[3] = 10;
+    std::memcpy(&pkt[4], &vip, 4);
+    std::memcpy(&pkt[kRelayHdr], body.data(), body.size());
+    ::sendto(s, reinterpret_cast<const char*>(pkt.data()), int(pkt.size()), 0,
+             reinterpret_cast<sockaddr*>(&relay), sizeof(relay));
+  };
+  auto last_hi = std::chrono::steady_clock::now() - std::chrono::seconds(10);
+  auto sent_at = std::chrono::steady_clock::time_point();
+  bool waiting_reply = false;
+  for (;;) {
+    std::vector<std::string> out;
+    {
+      std::lock_guard<std::mutex> lock(g_soc_mutex);
+      out.swap(g_soc_queue);
+    }
+    for (auto& q : out) send(q);
+    auto now = std::chrono::steady_clock::now();
+    if (!out.empty() || now - last_hi >= std::chrono::seconds(3)) {
+      last_hi = now;
+      send("hi");
+      if (!waiting_reply) { sent_at = std::chrono::steady_clock::now(); waiting_reply = true; }
+    }
+    char buf[16384];
+    sockaddr_in from = {};
+    int flen = sizeof(from);
+    int n = ::recvfrom(s, buf, sizeof(buf) - 1, 0, reinterpret_cast<sockaddr*>(&from), &flen);
+    if (n < int(kRelayHdr) || from.sin_addr.s_addr != r.addr_nbo) continue;
+    if (buf[0] != 'R' || buf[1] != 'L' || buf[2] != 1 || buf[3] != 11) continue;
+    if (waiting_reply) {
+      waiting_reply = false;
+      const int ms = int(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - sent_at).count());
+      std::lock_guard<std::mutex> lock(g_soc_mutex);
+      g_soc_srv.ping_ms = g_soc_srv.ping_ms < 0 ? ms : (g_soc_srv.ping_ms * 3 + ms) / 4;
+    }
+    std::vector<SocialInvite> fresh;
+    SocApply(std::string(buf + kRelayHdr, size_t(n) - kRelayHdr), &fresh);
+    for (auto& inv : fresh) {
+      REXKRNL_INFO("[social] invite #{} from {}", inv.id, inv.from);
+      OnlineSocialToast(inv);  // top-right notification; answered from the F1 panel, never blocks
+    }
+    std::vector<SocNote> notes;
+    {
+      std::lock_guard<std::mutex> lock(g_soc_mutex);
+      notes.swap(g_soc_new_notes);
+    }
+    for (auto& n : notes) {
+      REXKRNL_INFO("[social] notice #{} ({}): {}", n.id, n.kind, n.text);
+      OnlineSocialNotice(n.id, n.kind, n.text);
+    }
+    std::vector<SocialInvite> joins;
+    {
+      std::lock_guard<std::mutex> lock(g_soc_mutex);
+      joins.swap(g_soc_join_ready);
+      for (auto& inv : joins) {
+        g_soc_answered.insert(inv.id);
+        g_soc_queue.push_back("ans " + std::to_string(inv.id) + " 1");
+      }
+    }
+    for (auto& inv : joins) {
