+float DrawKey(ImDrawList* dl, ImVec2 p, float s, const char* key, const char* label, float alpha) {
+  ImFont* f = SocialFont();
+  const float ks = 17.0f * s, ls = 19.0f * s;
+  ImVec2 kt = f->CalcTextSizeA(ks, FLT_MAX, 0.0f, key);
+  ImVec2 lt = f->CalcTextSizeA(ls, FLT_MAX, 0.0f, label);
+  const float h = 26.0f * s, pad = 7.0f * s;
+  dl->AddRectFilled(p, ImVec2(p.x + kt.x + pad * 2, p.y + h), Col(255, 255, 255, alpha), 4.0f * s);
+  dl->AddText(f, ks, ImVec2(p.x + pad, p.y + (h - kt.y) * 0.5f), Col(17, 17, 17, alpha), key);
+  dl->AddText(f, ls, ImVec2(p.x + kt.x + pad * 2 + 6.0f * s, p.y + (h - lt.y) * 0.5f), Col(235, 235, 238, alpha), label);
