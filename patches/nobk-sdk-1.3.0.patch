+REXCVAR_DEFINE_BOOL(gpu_capture_next_frame, false, "GPU/Debug",
+                    "RenderDoc: capture the next guest frame (from one swap to the next), "
+                    "then reset. Needs the game launched from RenderDoc.")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(gpu_log_swap_resolves, true, "GPU/Debug",
+                    "Log swaps whose front buffer was not written by a resolve in that frame");
+
+namespace {
+// RenderDoc's own capture key (F12) captures one present of the host
+// swapchain, which only contains the presenter's work, not the guest
+// rendering. This brackets a whole guest frame on the device instead.
+void RenderDocCaptureOnSwap(ID3D12Device* device) {
+  static std::unique_ptr<rex::ui::RenderDocAPI> renderdoc =
+      rex::ui::RenderDocAPI::CreateIfConnected();
+  static bool capturing = false;
+  if (!renderdoc) {
+    if (REXCVAR_GET(gpu_capture_next_frame)) {
+      REXCVAR_SET(gpu_capture_next_frame, false);
+      REXGPU_WARN("gpu_capture_next_frame: RenderDoc is not attached, launch the game from RenderDoc");
+    }
+    return;
+  }
+  const RENDERDOC_API_1_0_0* api = renderdoc->api_1_0_0();
+  if (capturing) {
+    capturing = false;
+    uint32_t ok = api->EndFrameCapture(device, nullptr);
+    REXGPU_INFO("RenderDoc: guest frame capture {}", ok ? "saved" : "FAILED");
+  }
+  if (REXCVAR_GET(gpu_capture_next_frame)) {
+    REXCVAR_SET(gpu_capture_next_frame, false);
+    api->StartFrameCapture(device, nullptr);
+    capturing = true;
+    REXGPU_INFO("RenderDoc: capturing the next guest frame");
+  }
+}
+
+// Front buffer diagnostics: remembers every resolve destination between two
+// swaps and reports swaps whose source was not written by any resolve.
+struct FrameResolve {
+  uint32_t address, length;
+  bool ok;
+  uint32_t dest_base;  // RB_COPY_DEST_BASE as programmed by the game
+};
+std::vector<FrameResolve> g_frame_resolves;
+uint32_t g_frame_resolve_attempts = 0;
+uint64_t g_swap_index = 0;
+uint64_t g_missing_streak = 0;
+uint64_t g_missing_total = 0;
+
+void NoteResolve(bool ok, uint32_t address, uint32_t length, uint32_t dest_base) {
+  ++g_frame_resolve_attempts;
+  if (g_frame_resolves.size() < 64) {
+    g_frame_resolves.push_back({address, length, ok, dest_base});
+  }
+}
+
+void CheckSwapSource(uint32_t swap_base, uint32_t swap_length, uint32_t frontbuffer_ptr,
+                     uint32_t width, uint32_t height) {
+  ++g_swap_index;
+  if (!REXCVAR_GET(gpu_log_swap_resolves)) {
+    g_frame_resolves.clear();
+    g_frame_resolve_attempts = 0;
+    return;
+  }
+  bool written = false;
+  for (const FrameResolve& r : g_frame_resolves) {
+    if (r.ok && r.length && r.address < swap_base + swap_length &&
+        swap_base < r.address + r.length) {
+      written = true;
+      break;
+    }
+  }
+  if (g_swap_index <= 3) {
+    REXGPU_INFO("SwapDiag: swap #{} source {:08X} ({}x{}, VdSwap ptr {:08X}), resolves this frame {}, "
+                "front buffer written: {}",
+                g_swap_index, swap_base, width, height, frontbuffer_ptr, g_frame_resolve_attempts,
+                written ? "yes" : "NO");
+  }
+  if (!written) {
+    ++g_missing_streak;
+    ++g_missing_total;
+    if (g_missing_total <= 20 || g_missing_total % 300 == 0) {
+      std::string list;
+      for (size_t i = 0; i < g_frame_resolves.size(); ++i) {
+        const FrameResolve& r = g_frame_resolves[i];
+        if (r.length) {
+          list += fmt::format(" {:08X}+{:X}{}", r.address, r.length, r.ok ? "" : "(failed)");
+        } else {
+          list += fmt::format(" [no-copy dest {:08X}{}]", r.dest_base, r.ok ? "" : " failed");
+        }
+      }
+      REXGPU_WARN("SwapDiag: swap #{} shows {:08X} ({}x{}, VdSwap ptr {:08X}) but no resolve wrote it "
+                  "this frame (streak {}, total {}). {} resolves:{}",
+                  g_swap_index, swap_base, width, height, frontbuffer_ptr, g_missing_streak,
+                  g_missing_total, g_frame_resolve_attempts, list.empty() ? " none" : list);
+    }
+  } else if (g_missing_streak) {
+    REXGPU_WARN("SwapDiag: swap #{} front buffer {:08X} written again after {} stale frames",
+                g_swap_index, swap_base, g_missing_streak);
+    g_missing_streak = 0;
+  }
+  g_frame_resolves.clear();
+  g_frame_resolve_attempts = 0;
+}
+}  // namespace
 
