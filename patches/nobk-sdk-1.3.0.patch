+// [online] Random bytes for session ids, keys and nonces.
+static void OnlineRandomBytes(uint8_t* out, size_t n) {
+  static uint64_t state = 0;
+  if (!state) {
+    state = uint64_t(std::chrono::high_resolution_clock::now().time_since_epoch().count()) ^
+            0x9E3779B97F4A7C15ull;
+  }
+  for (size_t i = 0; i < n; ++i) {
+    state ^= state << 13;
+    state ^= state >> 7;
+    state ^= state << 17;
+    out[i] = uint8_t(state >> 24);
+  }
+}
+
+// [online] XUIDs of the players in the current session (local + remote), so
+// XSessionArbitrationRegister can return the registrant list ranked games need.
+static std::vector<uint64_t> g_session_xuids;
+static void AddSessionXuid(uint64_t xuid) {
+  if (!xuid) return;
+  for (auto x : g_session_xuids) if (x == xuid) return;
+  g_session_xuids.push_back(xuid);
+}
