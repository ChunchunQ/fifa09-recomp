+// ---------------------------------------------------------------- controller (XInput, read directly:
+// guest input is blocked while the panel is open, so the title never sees these presses)
+constexpr uint16_t kPadUp = 0x0001, kPadDown = 0x0002, kPadBack = 0x0020, kPadLB = 0x0100, kPadRB = 0x0200,
+                   kPadA = 0x1000, kPadB = 0x2000, kPadX = 0x4000;
+struct PadState {
+  bool ok = false;
+  uint16_t buttons = 0;
+  int16_t ly = 0;
+};
+PadState ReadPads() {
+  PadState r;
+  // the SDK's own input (SDL: PlayStation, Switch and Xbox pads, Steam Input ...), read for UI so it
+  // works while the guest is blocked; XInput below only as a fallback
+  if (auto* ks = REX_KERNEL_STATE()) {
+    if (auto* em = ks->emulator()) {
+      if (auto* is = static_cast<rex::input::InputSystem*>(em->input_system())) {
+        for (uint32_t i = 0; i < 4; ++i) {
+          rex::input::X_INPUT_STATE st{};
+          if (is->GetStateForUI(i, &st) != X_ERROR_SUCCESS) continue;
+          r.ok = true;
+          r.buttons |= uint16_t(st.gamepad.buttons);
+          const int16_t ly = int16_t(st.gamepad.thumb_ly);
+          if (std::abs(int(ly)) > std::abs(int(r.ly))) r.ly = ly;
+        }
+        if (r.ok) return r;
+      }
+    }
+  }
+#if REX_PLATFORM_WIN32
+  struct XIState { DWORD packet; uint16_t buttons; uint8_t lt, rt; int16_t lx, ly, rx, ry; };
+  using GetStateFn = DWORD(WINAPI*)(DWORD, XIState*);
+  static GetStateFn fn = [] {
+    HMODULE m = LoadLibraryW(L"xinput1_4.dll");
+    if (!m) m = LoadLibraryW(L"xinput9_1_0.dll");
+    return m ? reinterpret_cast<GetStateFn>(GetProcAddress(m, "XInputGetState")) : nullptr;
+  }();
+  if (!fn) return r;
+  for (DWORD i = 0; i < 4; ++i) {
+    XIState st{};
+    if (fn(i, &st) != 0) continue;
+    r.ok = true;
+    r.buttons |= st.buttons;
+    if (std::abs(int(st.ly)) > std::abs(int(r.ly))) r.ly = st.ly;
+  }
+#endif
+  return r;
+}
