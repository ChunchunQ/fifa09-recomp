+  timeval tv = {0, 0};
+  return ::select(0, &fds, nullptr, nullptr, &tv) > 0;
+#else
+  FD_SET(static_cast<int>(native), &fds);
+  timeval tv = {0, 0};
+  return ::select(static_cast<int>(native) + 1, &fds, nullptr, nullptr, &tv) > 0;
