diff --git a/src/kernel/xam/online_social.h b/src/kernel/xam/online_social.h
new file mode 100755
index 0000000..11965bc
--- /dev/null
+++ b/src/kernel/xam/online_social.h
@@ -0,0 +1,92 @@
+// [online] NOBK Online friends + game invites (Play a Friend).
+// Transport: a small UDP socket to the match relay (xam_net.cpp), relay types
+// 10 (request, text) and 11 (reply, text "SOC1" + lines). The server knows the
+// player from the relay vip + address, like the P2P control channel.
+//   requests:  "hi"                               poll (every 3 s)
+//              "inv <info hex 120> <name> [...]"   invite friends to my host session
+//              "ans <id> <1|0>"                    accept / decline an invite
+//   reply:     SOC1
+//              F <online 0|1> <playing 0|1> <xuid hex> <name>
+//              I <id> <xuid hex> <name> <info hex 120>
+// XamShowGameInviteUI (xam_ui.cpp) shows the friend picker; an incoming
+// invite pops up a dialog; accepting stores an XINVITE_INFO for
+// XInviteGetAcceptedInfo (xlivebase 0x58023) and sends XN_LIVE_INVITE_ACCEPTED.
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex {
+namespace kernel {
+namespace xam {
+
+struct SocialFriend {
+  std::string name;
+  uint64_t xuid = 0;
+  bool online = false;
+  bool playing = false;
+  std::string avatar;   // site path of the profile picture (PNG), "" = none
+  std::string country;  // ISO code, "" = unknown
+  bool joinable = false;  // hosts an open lobby we can join without an invite
+};
+
+struct SocialMe {          // profile card (game independent)
+  std::string name, avatar, country;
+  int64_t member_since = 0;  // unix time
+  int friends = 0;
+};
+
+struct SocialServer {
+  bool have = false;
+  int online = 0, searching = 0, live = 0;
+  int ping_ms = -1;
+};
+
+struct SocialNoticeLog {
+  uint32_t id = 0;
+  int kind = 0;  // 0 from NOBK, 1 invite declined
+  std::string text;
+  int64_t at = 0;  // unix time it arrived
+};
+
+struct SocialInvite {
+  uint32_t id = 0;
+  uint64_t from_xuid = 0;
+  std::string from;
+  std::string avatar;     // inviter's profile picture path, "" = none
+  uint8_t info[60] = {};  // XSESSION_INFO of the inviter's host session (guest byte order)
+};
+
+// xam_net.cpp
+void OnlineSocialStart();
+std::vector<SocialFriend> OnlineSocialFriends();
+void OnlineSocialSendInvite(const std::vector<std::string>& names);
+// Join a friend's open lobby without an invite: the server answers with an "A" line
+// (the host's session) and we accept it like an invite.
+void OnlineSocialJoin(const std::string& name);
+void OnlineSocialAnswer(uint32_t id, bool accept);
+void OnlineSocialSetHostSession(const uint8_t* info60);
+bool OnlineSocialHasHostSession();
+void OnlineSocialPoll();  // ask the server now (panel opened)
+bool OnlineSocialAcceptedInfo(uint8_t* out84);  // XINVITE_INFO, guest byte order
+void OnlineSocialSetAccepted(const SocialInvite& inv);
+std::vector<SocialInvite> OnlineSocialPending();   // invites not answered yet (newest first)
+void OnlineSocialAccept(uint32_t id);               // answer yes + XN_LIVE_INVITE_ACCEPTED
+void OnlineSocialDecline(uint32_t id);
+// Profile picture bytes (PNG) for a site path; false while it is still downloading (queued).
+bool OnlineSocialAvatar(const std::string& path, std::vector<uint8_t>* png);
+SocialMe OnlineSocialMe();
+SocialServer OnlineSocialServer();
+std::vector<SocialNoticeLog> OnlineSocialNotices();  // newest first, this session
+// xam_ui.cpp
+void OnlineSocialToast(const SocialInvite& inv);   // top-right notification + sound, never blocks the game
+void OnlineSocialToastDismiss(uint32_t id);       // answered: take its notification off the screen
+// notice from the server: kind 0 = from NOBK (yellow), 1 = your invite was declined
+void OnlineSocialNotice(uint32_t id, int kind, const std::string& text);
+void OnlineSocialStartPadWatch();                  // hold Back on a controller: open the panel
+void OnlineSocialOpenGuide();                       // F1: friends panel (opens / closes)
+void OnlineSocialOpenAchievements();                // F7: the panel on its Achievements tab
+
+}  // namespace xam
+}  // namespace kernel
+}  // namespace rex
