+ImU32 AvatarColour(const std::string& n) {
+  static const ImU32 c[] = {Col(227, 25, 46), Col(37, 99, 235), Col(22, 163, 74), Col(147, 51, 234), Col(234, 88, 12), Col(8, 145, 178)};
+  unsigned h = 0;
+  for (char ch : n) h = h * 31 + static_cast<unsigned char>(ch);
+  return c[h % 6];
