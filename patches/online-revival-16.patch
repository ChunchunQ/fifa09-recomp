@@ -41,6 +44,15 @@ static void OnlineRandomBytes(uint8_t* out, size_t n) {
   }
 }
 
+// [online] XUIDs of the players in the current session (local + remote), so
+// XSessionArbitrationRegister can return the registrant list ranked games need.
+static std::vector<uint64_t> g_session_xuids;
+static void AddSessionXuid(uint64_t xuid) {
+  if (!xuid) return;
+  for (auto x : g_session_xuids) if (x == xuid) return;
+  g_session_xuids.push_back(xuid);
+}
+
 XgiApp::XgiApp(KernelState* kernel_state) : App(kernel_state, 0xFB) {}
 
 // http://mb.mirage.org/bugzilla/xliveless/main.c
@@ -51,7 +63,7 @@ X_HRESULT XgiApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
