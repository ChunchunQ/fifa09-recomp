-      assert_true(!buffer_length || buffer_length == 16);
+      // [online] (was an assert: buffer_length == 16; FIFA 09 sends other sizes)
 
       uint32_t obj_ptr = memory::load_and_swap<uint32_t>(buffer + 0);
       uint32_t flags = memory::load_and_swap<uint32_t>(buffer + 4);
@@ -168,7 +182,7 @@ X_HRESULT XgiApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
