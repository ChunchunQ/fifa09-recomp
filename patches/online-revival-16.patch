@@ -179,10 +193,20 @@ X_HRESULT XgiApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
       REXKRNL_DEBUG("{}({:08X}, {}, {}, {:08X}, {:08X})",
                     is_local ? "XGISessionJoinLocal" : "XGISessionJoinRemote", session_ptr,
                     user_count, xuid_array_ptr, user_index_array, private_slots_array);
+      if (is_local) {
+        if (kernel_state_->user_profile()) AddSessionXuid(kernel_state_->user_profile()->xuid());
+      } else {
+        for (uint32_t i = 0; i < user_count && i < 16; ++i) {
+          AddSessionXuid(memory::load_and_swap<uint64_t>(
+              memory_->TranslateVirtual(xuid_array_ptr + i * 8)));
+        }
+      }
+      REXKRNL_INFO("[online] {}: {} player(s) in session", is_local ? "XSessionJoinLocal"
+                   : "XSessionJoinRemote", g_session_xuids.size());
       return X_E_SUCCESS;
     }
     case 0x000B0014: {
-      assert_true(!buffer_length || buffer_length == 16);
