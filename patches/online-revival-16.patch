       uint32_t flags = memory::load_and_swap<uint32_t>(buffer + 4);
@@ -311,11 +335,37 @@ X_HRESULT XgiApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
       REXKRNL_DEBUG("XSessionArbitrationRegister({:08X}, {:08X}, {:016X}, {:08X}, {:08X}, {:08X})",
                     obj_ptr, flags, session_nonce, session_duration_sec, results_buffer_size,
                     results_ptr);
+      // [online] Fill XSESSION_REGISTRATION_RESULTS { WORD wNumRegistrants;
+      // XSESSION_REGISTRANT* rgRegistrants; } with one registrant per player:
+      // { ULONGLONG qwMachineID; DWORD bTrustworthiness; DWORD bNumUsers;
+      //   XUID* rgUsers; } (24 bytes). An empty result made the game drop the
+      // session ("session is no longer available").
+      if (results_ptr && results_buffer_size >= 8) {
+        uint8_t* res = memory_->TranslateVirtual(results_ptr);
+        uint32_t count = uint32_t(g_session_xuids.size());
+        uint32_t need = 8 + count * 24 + count * 8;
+        if (need > results_buffer_size) count = (results_buffer_size - 8) / 32;
+        std::memset(res, 0, std::min<uint32_t>(results_buffer_size, 8 + count * 32));
+        memory::store_and_swap<uint16_t>(res + 0, uint16_t(count));
+        uint32_t reg_ptr = results_ptr + 8;
+        uint32_t xuid_ptr = reg_ptr + count * 24;
+        memory::store_and_swap<uint32_t>(res + 4, count ? reg_ptr : 0);
+        for (uint32_t i = 0; i < count; ++i) {
+          uint8_t* r = memory_->TranslateVirtual(reg_ptr + i * 24);
+          memory::store_and_swap<uint64_t>(r + 0, g_session_xuids[i]);  // machine id
+          memory::store_and_swap<uint32_t>(r + 8, 1);                    // trustworthy
+          memory::store_and_swap<uint32_t>(r + 12, 1);                   // one user
+          memory::store_and_swap<uint32_t>(r + 16, xuid_ptr + i * 8);
+          memory::store_and_swap<uint64_t>(memory_->TranslateVirtual(xuid_ptr + i * 8),
+                                           g_session_xuids[i]);
+        }
+        REXKRNL_INFO("[online] XSessionArbitrationRegister: {} registrant(s)", count);
+      }
 
       return X_E_SUCCESS;
     }
