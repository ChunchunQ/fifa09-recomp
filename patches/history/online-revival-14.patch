-  if (overlapped_ptr) {
-    // auto evt = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(
-    //    overlapped_ptr->event_handle);
-
-    // if (evt) {
-    //  //evt->Set(0, false);
-    //}
+  // (The old prototype was missing lpFromlen, which shifted the overlapped
+  // pointer by one argument.)
+  auto sock = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket);
+  if (!sock) {
+    XThread::SetLastError(0x2736);  // WSAENOTSOCK
+    return -1;
+  }
+  PendingRecv r;
+  r.native = sock->native_handle();
+  for (uint32_t i = 0; i < buffer_count && i < 16; ++i) {
+    r.bufs.emplace_back(uint32_t(buffers_ptr[i].buf_ptr), uint32_t(buffers_ptr[i].len));
+  }
+  r.from_ptr = from_addr.guest_address();
+  r.overlapped_ptr = overlapped_ptr.guest_address();
+  r.bytes_ptr = num_bytes_recv.guest_address();
+  r.fromlen_ptr = fromlen_ptr.guest_address();
+
+  int err = 0;
+  int n = RecvIntoGuest(r, &err);
+  if (n >= 0) {
+    if (num_bytes_recv) *num_bytes_recv = uint32_t(n);
+    if (flags_ptr) *flags_ptr = 0;
+    CompleteOverlapped(r.overlapped_ptr, 0, uint32_t(n));
+    return 0;
+  }
+  if (!WouldBlock(err) || !r.overlapped_ptr) {
+    XThread::SetLastError(WouldBlock(err) ? 0x2733 : uint32_t(err));
+    return -1;
   }
 
-  // we're not going to be receiving packets any time soon
-  // return error so we don't wait on that - Cancerous
+  // Nothing yet: complete asynchronously.
+  auto* ov = REX_KERNEL_MEMORY()->TranslateVirtual<XWSAOVERLAPPED*>(r.overlapped_ptr);
+  ov->internal_high = 0;
+  ov->internal = kStatusPending;
+  std::thread([r]() {
+    for (;;) {
+      fd_set rf;
+      FD_ZERO(&rf);
+#if REX_PLATFORM_WIN32
+      FD_SET(static_cast<SOCKET>(r.native), &rf);
+      int sel = ::select(0, &rf, nullptr, nullptr, nullptr);
+#else
+      FD_SET(static_cast<int>(r.native), &rf);
+      int sel = ::select(static_cast<int>(r.native) + 1, &rf, nullptr, nullptr, nullptr);
+#endif
+      if (sel < 0) {
+        CompleteOverlapped(r.overlapped_ptr, 995 /* WSA_OPERATION_ABORTED */, 0);
+        return;
+      }
+      int e = 0;
+      int got = RecvIntoGuest(r, &e);
+      if (got >= 0) {
+        CompleteOverlapped(r.overlapped_ptr, 0, uint32_t(got));
+        return;
+      }
+      if (!WouldBlock(e)) {
+        CompleteOverlapped(r.overlapped_ptr, uint32_t(e), 0);
+        return;
+      }
+    }
+  }).detach();
+  XThread::SetLastError(kWsaIoPending);
   return -1;
 }
 
+u32 NetDll_WSAGetOverlappedResult_entry(u32 caller, u32 socket,
+                                        ppc_ptr_t<XWSAOVERLAPPED> overlapped,
+                                        mapped_u32 bytes_transferred, u32 wait,
+                                        mapped_u32 flags_ptr) {
+  if (!overlapped) {
+    XThread::SetLastError(87);
+    return 0;
+  }
+  uint32_t status = overlapped->internal;
+  if (status == kStatusPending && wait) {
+    // Rare: block until the receive thread completes it.
+    for (int i = 0; i < 5000 && overlapped->internal == kStatusPending; ++i) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    status = overlapped->internal;
+  }
+  if (status == kStatusPending) {
+    XThread::SetLastError(kWsaIoIncomplete);
+    return 0;
+  }
+  if (status != 0) {
+    XThread::SetLastError(status);
+    return 0;
+  }
+  if (bytes_transferred) *bytes_transferred = uint32_t(overlapped->internal_high);
+  if (flags_ptr) *flags_ptr = 0;
+  return 1;
+}
