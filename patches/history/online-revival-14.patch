+// ---------------------------------------------------------------------------
+// [online] Same-PC testing: port offsets.
+// Two instances on one PC cannot both bind UDP 6000/3659. With
+// online_port_offset=N an instance binds port+N instead (and reports the
+// unshifted port to the game); packets sent to this PC (loopback or our own
+// address) get online_peer_port_offset added to the destination port, and
+// packets received from this PC have it subtracted from their source port.
+// Both default to 0, which changes nothing.
+static int OwnPortOffset() { return REXCVAR_GET(online_port_offset); }
+static int PeerPortOffset() { return REXCVAR_GET(online_peer_port_offset); }
+
+static uint32_t CachedLocalIPv4NBO() {
+  static uint32_t ip = PrimaryLocalIPv4NBO();
+  return ip;
+}
+
+// addr: 4 raw network-order bytes.
+static bool IsThisMachine(const void* addr) {
+  const uint8_t* a = static_cast<const uint8_t*>(addr);
+  if (a[0] == 127) return true;
+  uint32_t local = CachedLocalIPv4NBO();
+  return std::memcmp(a, &local, 4) == 0;
+}
+
+static uint16_t RawPort(const void* p) {
+  const uint8_t* b = static_cast<const uint8_t*>(p);
+  return uint16_t((uint16_t(b[0]) << 8) | b[1]);
+}
+static void SetRawPort(void* p, uint16_t port) {
+  uint8_t* b = static_cast<uint8_t*>(p);
+  b[0] = uint8_t(port >> 8);
+  b[1] = uint8_t(port & 0xFF);
+}
+
+static std::mutex g_offset_ports_mutex;
+static std::set<uint16_t> g_offset_ports;  // actual (shifted) ports we bound
+
+// Outgoing packet to this PC: shift the destination port to the peer instance.
+static void ApplyPeerOffsetOut(N_XSOCKADDR_IN* to) {
+  int off = PeerPortOffset();
+  if (!to || !off || !IsThisMachine(&to->sin_addr)) return;
+  uint16_t port = RawPort(&to->sin_port);
+  if (port) SetRawPort(&to->sin_port, uint16_t(port + off));
+}
+// Incoming packet from this PC: undo the peer's shift on the source port.
+static void ApplyPeerOffsetIn(N_XSOCKADDR_IN* from) {
+  int off = PeerPortOffset();
+  if (!from || !off || !IsThisMachine(&from->sin_addr)) return;
+  uint16_t port = RawPort(&from->sin_port);
+  if (port > off) SetRawPort(&from->sin_port, uint16_t(port - off));
+}
