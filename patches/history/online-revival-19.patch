From: Chun <tanimlanamayanoyuncu@gmail.com>
Date: Thu, 15 Oct 2026 18:30:49 +0300
Subject: [PATCH] local: per-second UDP stats, quieter WSAGetLastError log

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LQoazeoBfEffqvK6NngMiX
---
 src/kernel/xam/xam_net.cpp | 39 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/src/kernel/xam/xam_net.cpp b/src/kernel/xam/xam_net.cpp
index f1aecfc..4904ff6 100644
--- a/src/kernel/xam/xam_net.cpp
+++ b/src/kernel/xam/xam_net.cpp
@@ -18,6 +18,7 @@
 #include <chrono>
 #include <cstdio>
 #include <cstring>
+#include <map>
 #include <mutex>
 #include <set>
 #include <thread>
@@ -220,6 +221,38 @@ static void ApplyPeerOffsetIn(N_XSOCKADDR_IN* from) {
   if (port > off) SetRawPort(&from->sin_port, uint16_t(port - off));
 }
 
+// [online] Once-a-second UDP traffic summary per game port (always on while
+// online), so a dropped match shows whether packets stopped flowing.
+struct UdpPortStats {
+  uint32_t sent = 0, recv = 0, sent_bytes = 0, recv_bytes = 0;
+};
+static std::mutex g_udp_stats_mutex;
+static std::map<uint16_t, UdpPortStats> g_udp_stats;
+static std::chrono::steady_clock::time_point g_udp_stats_last;
+
+static void UdpStatsFlushLocked() {
+  auto now = std::chrono::steady_clock::now();
+  if (now - g_udp_stats_last < std::chrono::seconds(1)) return;
+  g_udp_stats_last = now;
+  if (g_udp_stats.empty()) return;
+  std::string line;
+  for (auto& [port, st] : g_udp_stats) {
+    char b[96];
+    std::snprintf(b, sizeof(b), " %u: out %u (%uB) in %u (%uB) |", port, st.sent, st.sent_bytes,
+                  st.recv, st.recv_bytes);
+    line += b;
+  }
+  g_udp_stats.clear();
+  REXKRNL_INFO("[udp-stats]{}", line);
+}
+static void UdpStatsCount(uint16_t port, bool out, uint32_t bytes) {
+  if (!OnlineFeature("link")) return;
+  std::lock_guard<std::mutex> lock(g_udp_stats_mutex);
+  auto& st = g_udp_stats[port];
+  if (out) { st.sent++; st.sent_bytes += bytes; } else { st.recv++; st.recv_bytes += bytes; }
+  UdpStatsFlushLocked();
+}
+
 // https://github.com/G91/TitanOffLine/blob/1e692d9bb9dfac386d08045ccdadf4ae3227bb5e/xkelib/xam/xamNet.h
 enum {
   XNCALLER_INVALID = 0x0,
@@ -467,7 +500,9 @@ u32 NetDll_WSACleanup_entry(u32 caller) {
 
 u32 NetDll_WSAGetLastError_entry() {
   uint32_t e = XThread::GetLastError();
-  if (PacketLogEnabled() && e != 0) {
+  // Skip the routine "would block / pending / incomplete" codes: the game
+  // polls them thousands of times and they drown the log.
+  if (PacketLogEnabled() && e != 0 && e != 0x2733 && e != 0x3e4 && e != 0x3e5) {
     REXKRNL_INFO("[net-pkt] WSAGetLastError -> {:#x}", e);
   }
   return e;
@@ -540,6 +575,7 @@ static int RecvIntoGuest(const PendingRecv& r, int* err) {
     std::memcpy(&nf.sin_addr, &from.sin_addr.s_addr, 4);
     std::memcpy(&nf.sin_port, &from.sin_port, 2);
     ApplyPeerOffsetIn(&nf);
+    UdpStatsCount(RawPort(&nf.sin_port), false, uint32_t(n));
     memory::store_and_swap<uint16_t>(f + 0, 2);  // AF_INET
     std::memcpy(f + 2, &nf.sin_port, 2);
     std::memcpy(f + 4, &nf.sin_addr, 4);
@@ -1861,6 +1897,7 @@ u32 NetDll_sendto_entry(u32 caller, u32 socket_handle, mapped_void buf_ptr, u32
   }
 
   N_XSOCKADDR_IN native_to(to_ptr);
+  UdpStatsCount(RawPort(&native_to.sin_port), true, buf_len);
   ApplyPeerOffsetOut(&native_to);
   if (PacketLogEnabled()) {
     char dst[48], peek[64];
