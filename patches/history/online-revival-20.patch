+// ---------------------------------------------------------------------------
+// [online] Match traffic relay (online_relay = "host:port").
+// Every player gets a virtual address 10.x.y.z (low 24 bits of the XUID); the
+// lobby server hands those out as player addresses and our XNADDR carries it.
+// Packets the game sends to a 10.x.y.z address are wrapped in a 16-byte header
+//   'R' 'L' 1 type | src_vip(4) src_port(2) | dst_vip(4) dst_port(2)
+// and sent to the relay from the same socket; packets coming back from the
+// relay are unwrapped and reported as coming from src_vip:src_port.
+static constexpr size_t kRelayHdr = 16;
+
+struct RelayConfig {
+  bool enabled = false;
+  uint32_t addr_nbo = 0;
+  uint16_t port = 0;
+};
+
+static const RelayConfig& Relay() {
+  static RelayConfig cfg = [] {
+    RelayConfig c;
+    std::string v = REXCVAR_GET(online_relay);
+    if (v.empty() || !OnlineFeature("link")) return c;
+    std::string host = v;
+    uint16_t port = 3658;
+    size_t colon = v.rfind(':');
+    if (colon != std::string::npos) {
+      host = v.substr(0, colon);
+      port = uint16_t(std::atoi(v.c_str() + colon + 1));
+    }
+    uint32_t a = inet_addr(host.c_str());
+    if (a == INADDR_NONE) {
+      if (hostent* he = gethostbyname(host.c_str())) {
+        if (he->h_addrtype == AF_INET && he->h_addr_list[0]) std::memcpy(&a, he->h_addr_list[0], 4);
+      }
+    }
+    if (a != INADDR_NONE && a != 0 && port) {
+      c.enabled = true;
+      c.addr_nbo = a;
+      c.port = port;
+      const uint8_t* b = reinterpret_cast<const uint8_t*>(&a);
+      REXKRNL_INFO("[online] match relay {}.{}.{}.{}:{}", b[0], b[1], b[2], b[3], port);
+    } else {
+      REXKRNL_WARN("[online] online_relay '{}' could not be resolved; playing without relay", v);
+    }
+    return c;
+  }();
+  return cfg;
+}
+
+// Our virtual address (network byte order), from the signed-in XUID.
+static uint32_t OwnVirtualIpNBO() {
+  uint64_t xuid = 0;
+  if (auto* ks = REX_KERNEL_STATE()) {
+    if (auto* up = ks->user_profile()) xuid = up->xuid();
+  }
+  uint32_t low = uint32_t(xuid & 0xFFFFFF);
+  if (!low) low = 1;
+  uint8_t b[4] = {10, uint8_t(low >> 16), uint8_t(low >> 8), uint8_t(low)};
+  uint32_t v;
+  std::memcpy(&v, b, 4);
+  return v;
+}
+
+static bool IsVirtualAddr(const void* addr) {
+  return Relay().enabled && static_cast<const uint8_t*>(addr)[0] == 10;
+}
+
+// The game's view of a socket's local port (bound port without our offset).
+static uint16_t LogicalLocalPort(uint64_t native) {
+  sockaddr_in local = {};
+#if REX_PLATFORM_WIN32
+  int len = static_cast<int>(sizeof(local));
+  if (::getsockname(static_cast<SOCKET>(native), reinterpret_cast<sockaddr*>(&local), &len) != 0)
+    return 0;
+#else
+  socklen_t len = sizeof(local);
+  if (::getsockname(static_cast<int>(native), reinterpret_cast<sockaddr*>(&local), &len) != 0)
+    return 0;
+#endif
+  uint16_t port = ntohs(local.sin_port);
+  if (OwnPortOffset() && port > OwnPortOffset()) {
+    std::lock_guard<std::mutex> lock(g_offset_ports_mutex);
+    if (g_offset_ports.count(port)) port = uint16_t(port - OwnPortOffset());
+  }
+  return port;
+}
+
+// Sends `data` to virtual `to` through the relay. Returns bytes of game data
+// sent (len) or -1.
+static int RelaySend(XSocket* sock, const uint8_t* data, uint32_t len, uint32_t flags,
+                     const N_XSOCKADDR_IN* to, uint8_t type = 1) {
+  const RelayConfig& r = Relay();
+  std::vector<uint8_t> pkt(kRelayHdr + len);
+  pkt[0] = 'R';
+  pkt[1] = 'L';
+  pkt[2] = 1;
+  pkt[3] = type;
+  uint32_t vip = OwnVirtualIpNBO();
+  std::memcpy(&pkt[4], &vip, 4);
+  SetRawPort(&pkt[8], LogicalLocalPort(sock->native_handle()));
+  if (to) {
+    std::memcpy(&pkt[10], &to->sin_addr, 4);
+    std::memcpy(&pkt[14], &to->sin_port, 2);
+  }
+  if (len) std::memcpy(&pkt[kRelayHdr], data, len);
+  N_XSOCKADDR_IN relay_to;
+  relay_to.sin_family = AF_INET;
+  std::memcpy(&relay_to.sin_addr, &r.addr_nbo, 4);
+  SetRawPort(&relay_to.sin_port, r.port);
+  std::memset(relay_to.x_sin_zero, 0, sizeof(relay_to.x_sin_zero));
+  int ret = sock->SendTo(pkt.data(), uint32_t(pkt.size()), flags, &relay_to, 16);
+  return ret < 0 ? -1 : int(len);
+}
+
+// If `data` is a relayed packet from the relay, returns the payload offset and
+// fills `from` with the virtual sender; otherwise returns 0.
+static size_t RelayUnwrap(const uint8_t* data, size_t n, const sockaddr_in& src,
+                          N_XSOCKADDR_IN* from) {
+  const RelayConfig& r = Relay();
+  if (!r.enabled || n < kRelayHdr) return 0;
+  if (src.sin_addr.s_addr != r.addr_nbo || ntohs(src.sin_port) != r.port) return 0;
+  if (data[0] != 'R' || data[1] != 'L' || data[2] != 1 || data[3] != 1) return 0;
+  std::memcpy(&from->sin_addr, data + 4, 4);
+  std::memcpy(&from->sin_port, data + 8, 2);
+  return kRelayHdr;
+}
+
