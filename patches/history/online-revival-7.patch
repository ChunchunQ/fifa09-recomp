From 6e1a82e307ab8ce9942ee4ee3ad90eddf9167e49 Mon Sep 17 00:00:00 2001
From: Chun <tanimlanamayanoyuncu@gmail.com>
Date: Thu, 15 Oct 2026 14:40:10 +0300
Subject: [PATCH] local: XamCreateEnumeratorHandle

---
 src/kernel/xam/xam_enum.cpp | 31 ++++++++++++++++++++++++++++---
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/src/kernel/xam/xam_enum.cpp b/src/kernel/xam/xam_enum.cpp
index 9dcab94..260de0d 100644
--- a/src/kernel/xam/xam_enum.cpp
+++ b/src/kernel/xam/xam_enum.cpp
@@ -9,6 +9,8 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <cstring>
+
 #include <rex/kernel/xam/module.h>
 #include <rex/kernel/xam/private.h>
 #include <rex/logging.h>
@@ -83,9 +85,32 @@ u32 XamEnumerate_entry(u32 handle, u32 flags, mapped_void buffer, u32 buffer_len
   return result;
 }
 
-u32 XamCreateEnumeratorHandle_entry(u32 unk1, u32 unk2, u32 unk3, u32 unk4, u32 unk5, u32 unk6,
-                                    u32 unk7, u32 unk8) {
-  return X_ERROR_INVALID_PARAMETER;
+// Creates an empty enumerator for an app message (e.g. XLIVEBASE 0x58040 =
+// marketplace offers). Titles signed in to LIVE use the handle without checking
+// the result, so an invalid handle corrupted FIFA 09's heap.
+u32 XamCreateEnumeratorHandle_entry(u32 user_index, u32 app_id, u32 open_message,
+                                    u32 close_message, u32 extra_size, u32 item_count,
+                                    u32 flags, mapped_u32 out_handle) {
+  if (out_handle) {
+    *out_handle = 0;
+  }
+  auto e = make_object<XStaticUntypedEnumerator>(REX_KERNEL_STATE(), item_count ? item_count : 1,
+                                                 extra_size ? extra_size : 1);
+  void* extra_buffer = nullptr;
+  auto result = e->Initialize(user_index, app_id, open_message, close_message, flags, extra_size,
+                              &extra_buffer);
+  if (XFAILED(result)) {
+    return result;
+  }
+  if (extra_buffer && extra_size) {
+    std::memset(extra_buffer, 0, extra_size);
+  }
+  REXKRNL_INFO("XamCreateEnumeratorHandle(app={:X}, open={:X}, items={}) -> empty, handle={:08X}",
+               app_id, open_message, item_count, e->handle());
+  if (out_handle) {
+    *out_handle = e->handle();
+  }
+  return X_ERROR_SUCCESS;
 }
 
 u32 XamGetPrivateEnumStructureFromHandle_entry(u32 handle, mapped_u32 out_object_ptr) {
