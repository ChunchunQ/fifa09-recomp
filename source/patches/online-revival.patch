+  return XnAddrStatus::XNET_GET_XNADDR_STATIC |
+         XnAddrStatus::XNET_GET_XNADDR_GATEWAY |
+         XnAddrStatus::XNET_GET_XNADDR_DNS |
+         XnAddrStatus::XNET_GET_XNADDR_ONLINE;
 }
 
