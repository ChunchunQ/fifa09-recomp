+// [online] Revival-server support for EA Blaze titles (adapted from the Skate 3
+// recompilation's online layer, DonaldDuck979/rexglue-skate3, BSD 3-Clause).
+// With online_enabled the console reports a working LIVE connection and every
+// EA/LIVE server lookup resolves to online_server_ip, so the game's own online
+// client talks to a self-hosted server. Off by default: nothing changes.
+REXCVAR_DEFINE_BOOL(online_enabled, false, "Net",
+                    "Report an online connection and send the game's EA/LIVE server "
+                    "lookups to online_server_ip (revival server)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_STRING(online_server_ip, "127.0.0.1", "Net",
+                      "IPv4 address of the revival server (Blaze)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_UINT32(online_server_port, 42127, "Net",
+                      "Port handed to the game in XOnlineGetServiceInfo")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_STRING(online_public_ip, "", "Net",
+                      "Address reported as this console's public IP (XNADDR inaOnline); "
+                      "empty = the local IP")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(net_packet_log, false, "Net",
+                    "Log every socket call, DNS lookup and XLIVEBASE message the game "
+                    "makes (destination, length, first 16 bytes)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
