<Window x:Class="Fifa09Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIFA 09 · NOBK.Online" Width="1280" Height="760"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
  <Grid>
    <!-- Photo over the whole window; its subject is on the right half, the settings
         column sits on the dark, blurred left part. -->
    <Grid ClipToBounds="True">
      <Image x:Name="BackgroundArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
             HorizontalAlignment="Right" VerticalAlignment="Top"/>
      <!-- light vignette so the title bar buttons and bottom edge stay readable -->
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8C0A0A0B" Offset="0"/>
            <GradientStop Color="#000A0A0B" Offset="0.18"/>
            <GradientStop Color="#000A0A0B" Offset="0.75"/>
            <GradientStop Color="#B30A0A0B" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- faint red glow from the bottom, like the website header -->
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.5,1.1" GradientOrigin="0.5,1.1" RadiusX="0.9" RadiusY="0.55">
            <GradientStop Color="#40E4202A" Offset="0"/>
            <GradientStop Color="#00E4202A" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- Fade from the solid settings column into the photo -->
    <Rectangle Width="900" HorizontalAlignment="Left" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#F20A0A0B" Offset="0"/>
          <GradientStop Color="#E00A0A0B" Offset="0.42"/>
          <GradientStop Color="#800A0A0B" Offset="0.66"/>
          <GradientStop Color="#000A0A0B" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Thin red line on the far left as a brand accent -->
    <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource Accent}"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar (drag to move) -->
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <!-- Language flags (filled from L.Languages), next to the window buttons -->
          <StackPanel x:Name="LangPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                  Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
          <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                  Style="{StaticResource WindowButton}" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <!-- Settings column -->
      <Grid Grid.Row="1" Width="540" HorizontalAlignment="Left" Margin="44,0,0,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo: FIFA 09 | NOBK.ONLINE -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,0">
          <!-- logo.png (built into the exe); falls back to text when missing -->
          <Image x:Name="LogoArt" Height="72" Stretch="Uniform" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
          <StackPanel x:Name="LogoText" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="FIFA" FontFamily="Bahnschrift" FontSize="54" FontWeight="Bold"/>
            <TextBlock Text="09" FontFamily="Bahnschrift" FontSize="54" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" Margin="12,0,0,0"/>
          </StackPanel>
          <Rectangle Width="2" Height="46" Margin="20,0,18,0" VerticalAlignment="Center" Fill="{StaticResource Line}"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="NOBK" FontFamily="Bahnschrift" FontSize="34" FontWeight="Bold"/>
            <TextBlock Text=".ONLINE" FontFamily="Bahnschrift" FontSize="34" FontWeight="Bold"
                       Foreground="{StaticResource Accent}"/>
          </StackPanel>
        </StackPanel>

        <!-- Tabs -->
        <Border Grid.Row="1" Margin="0,20,0,10">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="NavOnline" Content="Online" Style="{StaticResource NavTab}" GroupName="nav" IsChecked="True" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavDisplay" Content="Display" Style="{StaticResource NavTab}" GroupName="nav" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavGraphics" Content="Graphics" Style="{StaticResource NavTab}" GroupName="nav" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavControls" Content="Controls" Style="{StaticResource NavTab}" GroupName="nav" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavGame" Content="Files" Style="{StaticResource NavTab}" GroupName="nav" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavAch" Content="Achievements" Style="{StaticResource NavTab}" GroupName="nav" Checked="Nav_Checked"/>
          </StackPanel>
        </Border>

        <!-- Pages, on a card so the text never sits on the photo fade -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}"
                BorderThickness="1" CornerRadius="10" Padding="22,6,22,18">
        <Grid>
          <!-- Online (NOBK account) -->
          <StackPanel x:Name="PageOnline">
            <StackPanel x:Name="SignedOutPanel">
              <TextBlock Text="Sign in with your NOBK.Online account to play online. Your username is your name in the game."
                         Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"/>
              <TextBlock Text="Username" Style="{StaticResource Label}"/>
              <TextBox x:Name="UserBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" MaxLength="15"
                       Background="{StaticResource Field}" Foreground="{StaticResource Text}"
                       BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Text}"/>
              <TextBlock Text="Password" Style="{StaticResource Label}"/>
              <PasswordBox x:Name="PassBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                           Background="{StaticResource Field}" Foreground="{StaticResource Text}"
                           BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Text}"
                           KeyDown="PassBox_KeyDown"/>
              <CheckBox x:Name="RememberBox" Content="Remember me (sign in automatically next time)" IsChecked="True"
                        Margin="0,12,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource GhostButton}" MinWidth="96"
                        Click="SignIn_Click"/>
                <Button Content="Create account" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="Register_Click"/>
                <Button Content="Forgot password?" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="Forgot_Click"/>
              </StackPanel>
              <TextBlock Text="Not signed in: the game starts offline (NOBK.Online is not available)."
                         Style="{StaticResource Hint}" Margin="0,14,0,0"/>
            </StackPanel>
            <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
              <TextBlock Text="Signed in as" Style="{StaticResource Label}"/>
              <TextBlock x:Name="SignedInName" FontFamily="Bahnschrift" FontSize="32" FontWeight="Bold"/>
              <TextBlock x:Name="SignedInInfo" Style="{StaticResource Hint}"/>
              <CheckBox x:Name="OnlineBox" Content="Connect NOBK.Online services" Margin="0,16,0,0"/>
              <TextBlock Text="Off: the game starts offline, even when you are signed in." Style="{StaticResource Hint}"
                         Margin="28,4,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="My account" Style="{StaticResource GhostButton}" Click="MyAccount_Click"/>
                <Button Content="Sign out" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SignOut_Click"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="OnlineStatus" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/>
          </StackPanel>

          <!-- Display -->
          <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
            <TextBlock Text="Resolution" Style="{StaticResource Label}"/>
            <UniformGrid x:Name="ResTiles" Rows="1" Margin="-4,0"/>
            <TextBlock Text="720p and 1080p: AMD FSR sharpens and upscales the picture, fast on any PC. 2K and 4K: drawn natively, sharpest, but cost a lot of FPS. Fullscreen fills your screen; windowed uses the window size below."
                       Style="{StaticResource Hint}"/>
            <CheckBox x:Name="FullscreenBox" Content="Fullscreen (borderless, uses your desktop resolution)"
                      Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed"/>
            <TextBlock Text="Monitor" Style="{StaticResource Label}"/>
            <ComboBox x:Name="MonitorBox"/>
            <StackPanel x:Name="WindowSizePanel">
              <TextBlock Text="Window size" Style="{StaticResource Label}"/>
              <ComboBox x:Name="WindowSizeBox"/>
            </StackPanel>
            <TextBlock Text="Frame rate limit" Style="{StaticResource Label}"/>
            <UniformGrid x:Name="FpsTiles" Rows="1" Margin="-4,0"/>
            <TextBlock Text="Unlimited runs as fast as your PC allows. Game speed is not affected."
                       Style="{StaticResource Hint}"/>
          </StackPanel>

          <!-- Graphics -->
          <ScrollViewer x:Name="PageGraphics" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Texture filtering" Style="{StaticResource Label}"/>
            <ComboBox x:Name="AnisoBox"/>
            <TextBlock Text="Keeps the pitch, lines and crowd sharp at a distance. Almost free on modern GPUs."
                       Style="{StaticResource Hint}"/>
            <TextBlock Text="Graphics API" Style="{StaticResource Label}"/>
            <ComboBox x:Name="ApiBox"/>
            <TextBlock Text="Vulkan is experimental: jersey numbers may be missing."
                       Style="{StaticResource Hint}" Foreground="{StaticResource Warn}"/>
          </StackPanel>
          </ScrollViewer>

          <!-- Controls -->
          <Grid x:Name="PageControls" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Button prompts" Style="{StaticResource Label}" Margin="0,0,0,6"/>
              <ComboBox x:Name="PromptsBox" Margin="0,0,0,14"/>
              <CheckBox x:Name="KeyboardBox" Content="Play with keyboard (a controller works without this)"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="KeybindList"/>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Reset to defaults" Style="{StaticResource GhostButton}" Click="ResetKeys_Click"/>
              <TextBlock x:Name="KeyHint" Foreground="{StaticResource Muted}" FontSize="11"
                         VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="260"/>
            </StackPanel>
          </Grid>

          <!-- Game files -->
          <!-- Achievements -->
          <Grid x:Name="PageAch" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,12,0,8">
              <Grid>
                <StackPanel>
                  <TextBlock x:Name="AchCount" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock x:Name="AchScore" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AchPercent" FontFamily="Bahnschrift" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Border Height="6" CornerRadius="3" Background="{StaticResource Field}" Margin="0,10,0,0">
                <Border x:Name="AchBar" HorizontalAlignment="Left" CornerRadius="3" Width="0"
                        Background="{StaticResource Accent}"/>
              </Border>
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="AchPopupBox" Content="Pop-up in game" Margin="0,12,20,0"/>
                <CheckBox x:Name="AchSoundBox" Content="Sound" Margin="0,12,0,0"/>
              </StackPanel>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="AchList"/>
            </ScrollViewer>
          </Grid>

          <ScrollViewer x:Name="PageGame" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Folder with your extracted Xbox 360 FIFA 09 files (default.xex, data0.big, ...)"
                       Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource GhostButton}"
                      Margin="8,0,0,0" Click="Browse_Click"/>
              <TextBox x:Name="GameFolderBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                       IsReadOnly="True" Background="{StaticResource Field}" Foreground="{StaticResource Text}"
                       BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Text}"/>
            </DockPanel>
            <Button Content="Verify game files" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Click="Verify_Click"/>
            <TextBlock x:Name="VerifyResult" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
            <TextBlock Text="Steam" Style="{StaticResource Label}" Margin="0,22,0,6"/>
            <Button Content="Add to Steam" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Click="AddToSteam_Click"/>
            <TextBlock x:Name="SteamStatus" Style="{StaticResource Hint}"
                       Text="Adds the game to your Steam library with artwork. Works on Steam Deck too."/>
            <TextBlock Text="Report a problem" Style="{StaticResource Label}" Margin="0,22,0,6"/>
            <DockPanel>
              <Button x:Name="LogButton" DockPanel.Dock="Right" Content="Send log" Style="{StaticResource GhostButton}"
                      Margin="8,0,0,0" Click="SendLog_Click"/>
              <TextBox x:Name="LogNote" Height="36" Padding="8,0" VerticalContentAlignment="Center" MaxLength="300"
                       Background="{StaticResource Field}" Foreground="{StaticResource Text}"
                       BorderBrush="{StaticResource Line}" CaretBrush="{StaticResource Text}"/>
            </DockPanel>
            <TextBlock x:Name="LogStatus" Style="{StaticResource Hint}"
                       Text="Write what happened (minute, opponent), then send. The game's log file goes to the NOBK.Online team."/>
            <CheckBox x:Name="DiagBox" Content="Detailed log (turn on to report a bug, then play once and send the log)"/>
            <TextBlock Text="Writes much more to the log file. Leave it off for normal play."
                       Style="{StaticResource Hint}" Margin="28,4,0,0"/>
            <TextBlock Text="Game content is not included. Use files from your own copy of the game."
                       Style="{StaticResource Hint}" Margin="0,18,0,0"/>
          </StackPanel>
          </ScrollViewer>
        </Grid>
        </Border>

        <!-- New launcher version (hidden until the server reports one) -->
        <Border x:Name="UpdateBar" Grid.Row="3" Visibility="Collapsed" Margin="0,14,0,0" Padding="14,10"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                BorderThickness="3,0,0,0" CornerRadius="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock x:Name="UpdateTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="UpdateNotes" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource AccentButton}"
                      Click="Update_Click"/>
              <Button x:Name="UpdateLater" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                      Style="{StaticResource WindowButton}" Width="30" Height="30" Margin="4,0,0,0"
                      ToolTip="Later" Click="UpdateLater_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Status + play -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <Button x:Name="PlayButton" Grid.Column="1" Content="PLAY" Style="{StaticResource PlayButton}"
                  VerticalAlignment="Center" Click="Play_Click"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
